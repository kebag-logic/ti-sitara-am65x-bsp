diff --git a/milan-linux/src/rxsock.c b/milan-linux/src/rxsock.c
new file mode 100644
index 0000000..b8f37f5
--- /dev/null
+++ b/milan-linux/src/rxsock.c
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// rxsock.c - see rxsock.h.
+
+#define _GNU_SOURCE
+#include "rxsock.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <linux/if_packet.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+static int fail(struct rxsock_state *st, int fd, const char *step, int err)
+{
+	if (fd >= 0) {
+		close(fd);
+	}
+	st->step = step;
+	atomic_store(&st->result, -(err != 0 ? err : EIO));
+	return -1;
+}
+
+int rxsock_open(struct rxsock_state *st, const char *ifname, int (*filter)(int fd, uint64_t mac), int *ifindex)
+{
+	*ifindex = (int)if_nametoindex(ifname);
+	if (*ifindex == 0) {
+		return fail(st, -1, "interface", errno);
+	}
+	int fd = socket(AF_PACKET, SOCK_RAW | SOCK_CLOEXEC, htons(ETH_P_ALL));
+	if (fd < 0) {
+		return fail(st, -1, "socket", errno);
+	}
+	if (filter(fd, 0) != 0) {
+		return fail(st, fd, "filter", errno);
+	}
+	struct sockaddr_ll sll = {.sll_family = AF_PACKET, .sll_protocol = htons(ETH_P_ALL), .sll_ifindex = *ifindex};
+	if (bind(fd, (struct sockaddr *)&sll, sizeof sll) != 0) {
+		return fail(st, fd, "bind", errno);
+	}
+	struct timeval tv = {0, 5000};
+	if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv) != 0) {
+		return fail(st, fd, "receive timeout", errno);
+	}
+	atomic_store(&st->result, 1);
+	return fd;
+}
+
+bool rxsock_failed(struct rxsock_state *st, const char **step, int *err)
+{
+	int r = atomic_load(&st->result);
+	if (r >= 0 || atomic_exchange(&st->logged, true)) {
+		return false;
+	}
+	*step = st->step;
+	*err = -r;
+	return true;
+}
diff --git a/milan-linux/src/rxsock.h b/milan-linux/src/rxsock.h
new file mode 100644
index 0000000..e03c948
--- /dev/null
+++ b/milan-linux/src/rxsock.h
@@ -0,0 +1,34 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// rxsock.h - the receive socket of a media input (the AAF listener, the CRF
+// receive path), and how its setup ended.
+//
+// An input's counters are valid only while a program counts them (media.h):
+// its thread marks them valid once this setup has succeeded, and a setup that
+// fails leaves them invalid, no descriptor open, and the step and errno for
+// the main thread to log (rxsock_failed).
+
+#ifndef MILAN_RXSOCK_H
+#define MILAN_RXSOCK_H
+
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+// How an input's setup ended: 0 still running, 1 receiving, -errno failed.
+struct rxsock_state {
+	atomic_int result;
+	const char *step;               // the step that failed, set before result
+	atomic_bool logged;
+};
+
+// AF_PACKET on ifname, the input's filter closed (filter(fd, 0)), bound to the
+// interface, a 5 ms receive timeout. The descriptor, or -1 with the state
+// failed and nothing left open.
+int rxsock_open(struct rxsock_state *st, const char *ifname, int (*filter)(int fd, uint64_t mac), int *ifindex);
+
+// The step and errno of a failed setup, the first time it is asked: true once.
+bool rxsock_failed(struct rxsock_state *st, const char **step, int *err);
+
+#endif // MILAN_RXSOCK_H
diff --git a/milan-linux/src/softfab.c b/milan-linux/src/softfab.c
index d4d45bd..d5aa94a 100644
--- a/milan-linux/src/softfab.c
+++ b/milan-linux/src/softfab.c
@@ -90,9 +90,35 @@ uint32_t mbx_hal_read32(uint32_t byte_offset)
 	return mbx_model_read(&bound->model, byte_offset);
 }
 
+_Static_assert(MBX_N_PUB_SINKS <= 32u, "a bit per sink of the publication block");
+
+// Each sink's BINDING.BOUND as the publication block holds it after a write,
+// against the last seen: every edge, in the write that made it, so a loop pass
+// that binds, unbinds and binds again shows each one.
+static void bound_edges(struct softfab *sf)
+{
+	const uint32_t *pub = sf->model.pub[0];
+	uint32_t now = 0;
+	for (unsigned k = 0; k < MBX_N_PUB_SINKS; ++k) {
+		uint32_t binding = pub[(MBX_PUB_SINK_BASE + MBX_PUB_SINK_STRIDE * k + MBX_PUB_SINK_REG_BINDING) / 4u];
+		now |= ((binding >> MBX_BINDING_BOUND_LSB) & 1u) << k;
+	}
+	uint32_t moved = now ^ sf->pub_bound;
+	sf->pub_bound = now;
+	for (unsigned k = 0; moved != 0u && k < MBX_N_PUB_SINKS; ++k) {
+		if ((moved >> k) & 1u) {
+			moved &= ~(1u << k);
+			if (sf->cfg.bound_changed != NULL) {
+				sf->cfg.bound_changed(sf->cfg.bound_ctx, k, (now >> k) & 1u);
+			}
+		}
+	}
+}
+
 void mbx_hal_write32(uint32_t byte_offset, uint32_t value)
 {
 	mbx_model_write(&bound->model, byte_offset, value, 0xFu);
+	bound_edges(bound);
 	tx_flush(bound);
 }
 
