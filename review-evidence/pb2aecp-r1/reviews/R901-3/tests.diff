--- /dev/null
+++ b/milan-linux/tests/run-netns-rxfail.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+
+# SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+# SPDX-License-Identifier: Apache-2.0
+
+# Run tests/rxfail.py: milan-ctrld on veth0, milan-mediad started again for
+# each receive setup failure rxfail.so injects, the controller on veth1, in a
+# private user and network namespace (unshare -rn), so it needs no root and
+# touches no real interface.
+#
+# usage: run-netns-rxfail.sh <build dir> [entity.conf]
+
+set -e
+HERE=$(cd "$(dirname "$0")" && pwd)
+
+if [ "$1" != --inside ]; then
+	B=$(realpath "${1:?usage: run-netns-rxfail.sh <build dir> [entity.conf]}")
+	ENTITY=$(realpath "${2:-$HERE/../config/entity.conf}")
+	exec unshare -rn sh "$0" --inside "$B" "$ENTITY"
+fi
+B=$2; ENTITY=$3
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+ip link set lo up
+ip link add veth0 address 02:1a:2b:3c:4d:5e type veth peer name veth1 address 02:00:00:00:00:02
+ip link set veth0 up
+ip link set veth1 up
+sleep 0.2
+python3 -I "$HERE/rxfail.py" --dut veth0 --peer veth1 --build "$B" --entity "$ENTITY" --tmp "$TMP"
diff --git a/milan-linux/tests/rxfail.c b/milan-linux/tests/rxfail.c
new file mode 100644
index 0000000..ebc1236
--- /dev/null
+++ b/milan-linux/tests/rxfail.c
@@ -0,0 +1,135 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// rxfail.c - an LD_PRELOAD library for tests/rxfail.py: makes one step of a
+// media input's receive socket setup (src/rxsock.c) fail, in one thread of
+// milan-mediad only, and says on stderr what it did.
+//
+//   RXFAIL_THREAD  the thread's name (milan-listener, milan-crf-rx)
+//   RXFAIL_STEP    interface, socket, filter, bind or timeout
+//
+// Each failure, and the close of a descriptor that thread opened, is written
+// to stderr as "rxfail: <thread> <what>", so a test can tell that a failed
+// setup left nothing open.
+
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <linux/filter.h>
+#include <net/if.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static __thread int opened = -1;        // the descriptor socket() gave this thread
+
+static bool targeted(const char *step)
+{
+	const char *t = getenv("RXFAIL_THREAD"), *s = getenv("RXFAIL_STEP");
+	char name[16] = {0};
+	if (t == NULL || s == NULL || prctl(PR_GET_NAME, name) != 0) {
+		return false;
+	}
+	return strcmp(name, t) == 0 && strcmp(s, step) == 0;
+}
+
+static bool in_thread(void)
+{
+	const char *t = getenv("RXFAIL_THREAD");
+	char name[16] = {0};
+	return t != NULL && prctl(PR_GET_NAME, name) == 0 && strcmp(name, t) == 0;
+}
+
+static void say(const char *fmt, ...)
+{
+	char line[160];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(line, sizeof line, fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		(void)!write(2, line, (size_t)n < sizeof line ? (size_t)n : sizeof line - 1u);
+	}
+}
+
+static int injected(const char *step, int err)
+{
+	say("rxfail: %s %s failed (%s)\n", getenv("RXFAIL_THREAD"), step, strerror(err));
+	errno = err;
+	return -1;
+}
+
+unsigned int if_nametoindex(const char *ifname)
+{
+	static unsigned int (*real)(const char *);
+	if (real == NULL) {
+		real = (unsigned int (*)(const char *))dlsym(RTLD_NEXT, "if_nametoindex");
+	}
+	if (targeted("interface")) {
+		(void)injected("interface", ENODEV);
+		return 0;
+	}
+	return real(ifname);
+}
+
+int socket(int domain, int type, int protocol)
+{
+	static int (*real)(int, int, int);
+	if (real == NULL) {
+		real = (int (*)(int, int, int))dlsym(RTLD_NEXT, "socket");
+	}
+	if (domain == AF_PACKET && targeted("socket")) {
+		return injected("socket", EMFILE);
+	}
+	int fd = real(domain, type, protocol);
+	if (domain == AF_PACKET && in_thread()) {
+		opened = fd;
+		say("rxfail: %s opened fd %d\n", getenv("RXFAIL_THREAD"), fd);
+	}
+	return fd;
+}
+
+int setsockopt(int fd, int level, int name, const void *value, socklen_t len)
+{
+	static int (*real)(int, int, int, const void *, socklen_t);
+	if (real == NULL) {
+		real = (int (*)(int, int, int, const void *, socklen_t))dlsym(RTLD_NEXT, "setsockopt");
+	}
+	if (fd == opened && level == SOL_SOCKET && name == SO_ATTACH_FILTER && targeted("filter")) {
+		return injected("filter", ENOMEM);
+	}
+	if (fd == opened && level == SOL_SOCKET && name == SO_RCVTIMEO && targeted("timeout")) {
+		return injected("timeout", EINVAL);
+	}
+	return real(fd, level, name, value, len);
+}
+
+int bind(int fd, const struct sockaddr *addr, socklen_t len)
+{
+	static int (*real)(int, const struct sockaddr *, socklen_t);
+	if (real == NULL) {
+		real = (int (*)(int, const struct sockaddr *, socklen_t))dlsym(RTLD_NEXT, "bind");
+	}
+	if (fd == opened && targeted("bind")) {
+		return injected("bind", EADDRNOTAVAIL);
+	}
+	return real(fd, addr, len);
+}
+
+int close(int fd)
+{
+	static int (*real)(int);
+	if (real == NULL) {
+		real = (int (*)(int))dlsym(RTLD_NEXT, "close");
+	}
+	if (fd >= 0 && fd == opened) {
+		say("rxfail: %s closed fd %d\n", getenv("RXFAIL_THREAD"), fd);
+		opened = -1;
+	}
+	return real(fd);
+}
diff --git a/milan-linux/tests/rxfail.py b/milan-linux/tests/rxfail.py
new file mode 100644
index 0000000..c423c3c
--- /dev/null
+++ b/milan-linux/tests/rxfail.py
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+# SPDX-License-Identifier: Apache-2.0
+"""rxfail.py - a media input whose receive socket cannot be set up reports none of its counters valid.
+
+milan-ctrld runs on the DUT side of the veth pair run-netns-rxfail.sh makes,
+and milan-mediad is started again for each case, its talker, AAF listener and
+CRF receive path on. rxfail.so (tests/rxfail.c) makes one setup step fail in
+one of its receiving threads; a controller on the peer side reads
+GET_COUNTERS:
+
+  control             nothing fails: STREAM_INPUT 0 and 1 valid 0xf3f
+  each step, each     interface, socket, filter, bind, receive timeout, in
+  input               the listener (STREAM_INPUT 0) or the CRF path
+                      (STREAM_INPUT 1): that input none valid, the other 0xf3f,
+                      milan-mediad still running, the failure logged with its
+                      step, and the descriptor it opened closed
+  no interface        milan-mediad on an interface that does not exist: both
+                      inputs none valid, both failures logged
+
+Usage (as root in the namespace): rxfail.py --dut veth0 --peer veth1 --build DIR --entity FILE --tmp DIR
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.dont_write_bytecode = True
+
+
+def load(name: str):
+    spec = importlib.util.spec_from_file_location(name, HERE / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+aecp = load("aecp")
+peer = aecp.peer
+
+THREADS = (("milan-listener", 0, "listener on"), ("milan-crf-rx", 1, "CRF input on"))
+STEPS = (("interface", "interface"), ("socket", "socket"), ("filter", "filter"), ("bind", "bind"),
+         ("timeout", "receive timeout"))
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    for k in ("--dut", "--peer", "--build", "--entity", "--tmp"):
+        ap.add_argument(k, required=True)
+    a = ap.parse_args()
+    g = peer.Grader()
+    probe = peer.socket.socket(peer.socket.AF_PACKET, peer.socket.SOCK_RAW, 0)
+    probe.bind((a.dut, 0))
+    dut_mac = probe.getsockname()[4]
+    probe.close()
+    eid = peer.mac_int(dut_mac[:3] + b"\xff\xfe" + dut_mac[3:])
+    shm = f"/milan-dp-rxf-{os.getpid()}"
+    media_name = f"/milan-media-rxf-{os.getpid()}"
+    gptp_name = f"flexptpd-rxf-{os.getpid()}"
+    ptp = aecp.Flexptpd(gptp_name, eid)
+    wire = peer.Wire(a.peer, dut_mac)
+    wire.control_only()
+    c = aecp.Controller(wire, dut_mac, eid, (peer.CONTROLLER,))
+    ctrld_log = open(os.path.join(a.tmp, "ctrld-rxf.log"), "w")
+    ctrld = subprocess.Popen([os.path.join(a.build, "milan-ctrld"), "-i", a.dut, "-e", a.entity, "-g", gptp_name,
+                              "-d", shm, "-m", media_name, "-N", "none", "-n"], stdout=ctrld_log, stderr=ctrld_log)
+    shim = os.path.join(a.build, "rxfail.so")
+    last = ""
+
+    def run(name: str, ifname: str, env: dict) -> tuple[bool, dict, str]:
+        """milan-mediad for one case: alive after 1 s, each input's counters_valid, its log."""
+        nonlocal last
+        path = os.path.join(a.tmp, f"mediad-rxf-{name}.log")
+        with open(path, "w") as log:
+            p = subprocess.Popen([os.path.join(a.build, "milan-mediad"), "-i", ifname, "-r", "talker,listener,crf",
+                                  "-S", "0", "-P", "0", "-d", shm, "-m", media_name],
+                                 stdout=log, stderr=log, env={**os.environ, **env})
+            time.sleep(1.0)
+            alive = p.poll() is None
+            valid = {k: aecp.counters(c, aecp.D_STREAM_INPUT, k)[0] for k in (0, 1)}
+            p.send_signal(signal.SIGTERM)
+            try:
+                p.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                p.kill()
+                p.wait()
+        last = open(path).read()
+        return alive, valid, last
+
+    try:
+        r = wire.wait(lambda f: peer.is_sub(peer.SUB_ADP, peer.ADP_AVAILABLE)(f), 7.0)
+        g.check("ADP: ENTITY_AVAILABLE", r is not None)
+        alive, valid, log = run("control", a.dut, {"LD_PRELOAD": shim, "RXFAIL_THREAD": "milan-listener",
+                                                   "RXFAIL_STEP": "none"})
+        g.check("control, nothing fails: STREAM_INPUT 0 and 1 valid 0xf3f, nothing logged as failed",
+                alive and valid == {0: 0xF3F, 1: 0xF3F} and "not received" not in log and "failed" not in log,
+                f"alive {alive} valid {valid}")
+        for thread, index, says in THREADS:
+            other = 1 - index
+            for step, logged in STEPS:
+                alive, valid, log = run(f"{thread}-{step}", a.dut, {"LD_PRELOAD": shim, "RXFAIL_THREAD": thread,
+                                                                     "RXFAIL_STEP": step})
+                name = f"{thread} {step} fails"
+                g.check(f"{name}: injected", f"rxfail: {thread} {step} failed" in log)
+                g.check(f"{name}: STREAM_INPUT {index} none valid, STREAM_INPUT {other} 0xf3f, milan-mediad "
+                        "running", alive and valid.get(index) == 0 and valid.get(other) == 0xF3F,
+                        f"alive {alive} valid {valid}")
+                g.check(f"{name}: logged with its step", f"{says} {a.dut}: {logged}:" in log
+                        and f"STREAM_INPUT {index} is not received, none of its counters valid" in log,
+                        next((x for x in log.splitlines() if "not received" in x), "no line"))
+                opened = re.search(rf"rxfail: {thread} opened fd (\d+)", log)
+                if step in ("interface", "socket"):
+                    g.check(f"{name}: no descriptor opened", opened is None)
+                else:
+                    g.check(f"{name}: the descriptor it opened is closed", opened is not None
+                            and f"rxfail: {thread} closed fd {opened.group(1)}" in log)
+        alive, valid, log = run("missing", "missing0", {})
+        g.check("no such interface: STREAM_INPUT 0 and 1 none valid, milan-mediad running",
+                alive and valid == {0: 0, 1: 0}, f"alive {alive} valid {valid}")
+        g.check("no such interface: both failures logged",
+                "listener on missing0: interface:" in log and "CRF input on missing0: interface:" in log)
+    finally:
+        if ctrld.poll() is None:
+            ctrld.send_signal(signal.SIGTERM)
+            try:
+                ctrld.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                ctrld.kill()
+        c.stop = True
+        wire.stop = True
+        ptp.close()
+        for name in (shm, media_name):
+            try:
+                os.unlink("/dev/shm" + name)
+            except OSError:
+                pass
+        ctrld_log.close()
+    print(f"rxfail: {'PASS' if g.failed == 0 else 'FAIL'} ({g.failed} failed)")
+    if g.failed:
+        print("--- last milan-mediad log ---")
+        print(last[-4000:])
+    return 1 if g.failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
