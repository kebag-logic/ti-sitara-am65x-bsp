index 0000000..51700c2
--- /dev/null
+++ b/milan-linux/src/crf.c
@@ -0,0 +1,103 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// crf.c - see crf.h.
+
+#include "crf.h"
+
+#include <string.h>
+
+#define ETHERTYPE_AVTP 0x22F0u
+#define ETHERTYPE_VLAN 0x8100u
+
+static void put_be(uint8_t *p, uint64_t v, unsigned bytes)
+{
+	for (unsigned i = bytes; i-- > 0;) {
+		p[i] = (uint8_t)v;
+		v >>= 8;
+	}
+}
+
+static uint64_t get_be(const uint8_t *p, unsigned bytes)
+{
+	uint64_t v = 0;
+	for (unsigned i = 0; i < bytes; ++i) {
+		v = (v << 8) | p[i];
+	}
+	return v;
+}
+
+bool crf_parse(const uint8_t *frame, size_t len, struct crf_pdu *out)
+{
+	size_t eth = 14u;
+	out->vlan_tci = 0;
+	if (len >= 18u && get_be(frame + 12, 2) == ETHERTYPE_VLAN) {
+		out->vlan_tci = (uint16_t)get_be(frame + 14, 2);
+		eth += 4u;
+	}
+	if (len < eth + CRF_HEADER_BYTES || get_be(frame + eth - 2, 2) != ETHERTYPE_AVTP) {
+		return false;
+	}
+	const uint8_t *h = frame + eth;
+	if (h[0] != CRF_SUBTYPE || ((h[1] >> 4) & 0x07u) != 0u) {
+		return false;
+	}
+	out->sv = (h[1] & 0x80u) != 0u;
+	out->mr = (h[1] & 0x08u) != 0u;
+	out->fs = (h[1] & 0x02u) != 0u;
+	out->tu = (h[1] & 0x01u) != 0u;
+	out->seq = h[2];
+	out->type = h[3];
+	out->stream_id = get_be(h + 4, 8);
+	uint32_t pf = (uint32_t)get_be(h + 12, 4);
+	out->pull = (uint8_t)(pf >> 29);
+	out->base_frequency = pf & 0x1FFFFFFFu;
+	out->data_len = (uint16_t)get_be(h + 16, 2);
+	out->timestamp_interval = (uint16_t)get_be(h + 18, 2);
+	if (out->data_len % 8u != 0u || eth + CRF_HEADER_BYTES + out->data_len > len) {
+		return false;
+	}
+	unsigned n = out->data_len / 8u;
+	out->n_timestamps = n < CRF_MAX_TIMESTAMPS ? n : CRF_MAX_TIMESTAMPS;
+	for (unsigned i = 0; i < out->n_timestamps; ++i) {
+		out->timestamps[i] = get_be(h + CRF_HEADER_BYTES + 8u * i, 8);
+	}
+	return true;
+}
+
+bool crf_is_milan(const struct crf_pdu *p)
+{
+	return p->sv && p->type == CRF_TYPE_AUDIO_SAMPLE && p->pull == CRF_MILAN_PULL &&
+	       p->base_frequency == CRF_MILAN_BASE_FREQUENCY && p->timestamp_interval == CRF_MILAN_INTERVAL &&
+	       p->data_len == 8u * CRF_MILAN_TIMESTAMPS;
+}
+
+size_t crf_build(uint8_t *out, size_t cap, const uint8_t dst[6], const uint8_t src[6], const struct crf_pdu *p)
+{
+	size_t eth = p->vlan_tci != 0u ? 18u : 14u;
+	unsigned n = p->n_timestamps < CRF_MAX_TIMESTAMPS ? p->n_timestamps : CRF_MAX_TIMESTAMPS;
+	size_t len = eth + CRF_HEADER_BYTES + 8u * n;
+	if (len > cap) {
+		return 0;
+	}
+	memcpy(out, dst, 6);
+	memcpy(out + 6, src, 6);
+	if (p->vlan_tci != 0u) {
+		put_be(out + 12, ETHERTYPE_VLAN, 2);
+		put_be(out + 14, p->vlan_tci, 2);
+	}
+	put_be(out + eth - 2, ETHERTYPE_AVTP, 2);
+	uint8_t *h = out + eth;
+	h[0] = CRF_SUBTYPE;
+	h[1] = (uint8_t)((p->sv ? 0x80u : 0u) | (p->mr ? 0x08u : 0u) | (p->fs ? 0x02u : 0u) | (p->tu ? 0x01u : 0u));
+	h[2] = p->seq;
+	h[3] = p->type;
+	put_be(h + 4, p->stream_id, 8);
+	put_be(h + 12, (uint32_t)p->pull << 29 | (p->base_frequency & 0x1FFFFFFFu), 4);
+	put_be(h + 16, 8u * n, 2);
+	put_be(h + 18, p->timestamp_interval, 2);
+	for (unsigned i = 0; i < n; ++i) {
+		put_be(h + CRF_HEADER_BYTES + 8u * i, p->timestamps[i], 8);
+	}
+	return len;
+}
diff --git a/milan-linux/src/crf.h b/milan-linux/src/crf.h
new file mode 100644
index 0000000..2906425
--- /dev/null
+++ b/milan-linux/src/crf.h
@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// crf.h - Clock Reference Format PDUs (IEEE 1722-2016 10.4, Figure 72), as
+// the Avnu Pro Audio CRF Media Clock Stream Format carries them (Milan v1.2
+// 7.3.2, Table 7.1: CRF_AUDIO_SAMPLE, 48 000 Hz, pull 0, timestamp_interval
+// 96, one timestamp a PDU; the AEM format 0x041060010000BB80).
+//
+//   byte 0      subtype 0x04 (CRF)
+//   byte 1      sv (bit 7), version (6..4), mr (3), r (2), fs (1), tu (0)
+//   byte 2      sequence_num
+//   byte 3      type (1 = CRF_AUDIO_SAMPLE)
+//   4..11       stream_id
+//   12..15      pull (31..29), base_frequency (28..0)
+//   16..17      crf_data_length (octets, a multiple of 8)
+//   18..19      timestamp_interval (events between timestamps)
+//   20..        crf_data: 64-bit gPTP times in ns, each conceptually an
+//               avtp_timestamp (10.4.13.1), big-endian
+
+#ifndef MILAN_CRF_H
+#define MILAN_CRF_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define CRF_SUBTYPE 0x04u
+#define CRF_HEADER_BYTES 20u
+#define CRF_TYPE_AUDIO_SAMPLE 0x01u
+#define CRF_MAX_TIMESTAMPS 16u
+
+// The Milan format, field by field (Milan v1.2 Table 7.1)
+#define CRF_MILAN_BASE_FREQUENCY 48000u
+#define CRF_MILAN_PULL 0u
+#define CRF_MILAN_INTERVAL 96u
+#define CRF_MILAN_TIMESTAMPS 1u
+#define CRF_MILAN_FORMAT 0x041060010000BB80ull
+
+struct crf_pdu {
+	uint16_t vlan_tci;              // 0 when the frame carried no tag
+	bool sv, mr, fs, tu;
+	uint8_t seq;
+	uint8_t type;
+	uint64_t stream_id;
+	uint8_t pull;
+	uint32_t base_frequency;
+	uint16_t data_len;
+	uint16_t timestamp_interval;
+	unsigned n_timestamps;          // data_len / 8, at most CRF_MAX_TIMESTAMPS read
+	uint64_t timestamps[CRF_MAX_TIMESTAMPS];
+};
+
+// Parse an Ethernet frame, 802.1Q-tagged or not. False for anything that is
+// not a complete CRF PDU of version 0 whose crf_data_length is a multiple of 8.
+bool crf_parse(const uint8_t *frame, size_t len, struct crf_pdu *out);
+
+// Whether a PDU is in the Milan CRF format, the one STREAM_INPUT 1 runs.
+bool crf_is_milan(const struct crf_pdu *p);
+
+// The other way (the tests' talker): one frame, untagged unless vlan_tci, with
+// p's header and timestamps. Returns its length, 0 when `cap` is too small.
+size_t crf_build(uint8_t *out, size_t cap, const uint8_t dst[6], const uint8_t src[6], const struct crf_pdu *p);
+
+#endif // MILAN_CRF_H
diff --git a/milan-linux/src/crf_rx.c b/milan-linux/src/crf_rx.c
new file mode 100644
index 0000000..c38f3bd
--- /dev/null
+++ b/milan-linux/src/crf_rx.c
@@ -0,0 +1,330 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// crf_rx.c - see crf_rx.h.
+
+#define _GNU_SOURCE
+#include "crf_rx.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <linux/filter.h>
+#include <linux/if_packet.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <sched.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include "crf.h"
+
+#define CHECK_NS 10000000               // the datapath block is read every 10 ms
+#define REPORT_NS 100000000             // the report is published every 100 ms
+
+enum cstate { C_NONE, C_WAITING, C_RUNNING };
+
+static void live_update(struct crf_rx *x, const struct milan_media_crf *r)
+{
+	shmblk_begin(&x->live);
+	x->live.r = *r;
+	shmblk_end(&x->live);
+}
+
+void crf_rx_report(const struct crf_rx *x, struct milan_media_crf *out)
+{
+	struct crf_rx_live copy;
+	if (shmblk_snapshot(&x->live, &copy, sizeof copy)) {
+		*out = copy.r;
+	}
+}
+
+static bool sink_of(const struct crf_rx *x, struct milan_dp_sink *k)
+{
+	struct milan_dp dp;
+	if (!milan_dp_snapshot(x->cfg.dp, &dp) || x->cfg.sink >= dp.n_sinks) {
+		return false;
+	}
+	*k = dp.sinks[x->cfg.sink];
+	return true;
+}
+
+// The stream's frames only: its destination, AVTP, subtype CRF, tagged or not.
+static int set_filter(int fd, uint64_t mac)
+{
+	uint32_t hi = (uint32_t)(mac >> 16);
+	uint32_t lo = (uint32_t)(mac & 0xFFFFu);
+	struct sock_filter f[] = {
+		/* 0 */ BPF_STMT(BPF_LD | BPF_W | BPF_ABS, 0),
+		/* 1 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, hi, 0, 12),
+		/* 2 */ BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 4),
+		/* 3 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, lo, 0, 10),
+		/* 4 */ BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 12),
+		/* 5 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x8100, 0, 4),
+		/* 6 */ BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 16),
+		/* 7 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x22F0, 0, 6),
+		/* 8 */ BPF_STMT(BPF_LD | BPF_B | BPF_ABS, 18),
+		/* 9 */ BPF_JUMP(BPF_JMP | BPF_JA, 2, 0, 0),
+		/* 10 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x22F0, 0, 3),
+		/* 11 */ BPF_STMT(BPF_LD | BPF_B | BPF_ABS, 14),
+		/* 12 */ BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, CRF_SUBTYPE, 0, 1),
+		/* 13 */ BPF_STMT(BPF_RET | BPF_K, 0xFFFF),
+		/* 14 */ BPF_STMT(BPF_RET | BPF_K, 0),
+	};
+	struct sock_fprog prog = {sizeof f / sizeof f[0], f};
+	return setsockopt(fd, SOL_SOCKET, SO_ATTACH_FILTER, &prog, sizeof prog);
+}
+
+static void membership(int fd, int ifindex, uint64_t mac, bool add)
+{
+	struct packet_mreq mr = {.mr_ifindex = ifindex, .mr_type = PACKET_MR_MULTICAST, .mr_alen = 6};
+	for (int i = 5; i >= 0; --i) {
+		mr.mr_address[i] = (uint8_t)mac;
+		mac >>= 8;
+	}
+	(void)setsockopt(fd, SOL_PACKET, add ? PACKET_ADD_MEMBERSHIP : PACKET_DROP_MEMBERSHIP, &mr, sizeof mr);
+}
+
+static void set_locked(struct milan_media_crf *r, bool locked)
+{
+	if (locked && !r->locked) {
+		r->media_locked++;
+		r->milan.value[MILAN_SI_MEDIA_LOCKED]++;
+	} else if (!locked && r->locked) {
+		r->media_unlocked++;
+		r->milan.value[MILAN_SI_MEDIA_UNLOCKED]++;
+	}
+	r->locked = locked;
+}
+
+// The media clock the stream carries, as its timestamps lay it out.
+struct grid {
+	bool have;                      // a last stamp to step from
+	uint8_t seq;                    // its PDU's sequence_num
+	uint64_t ts;                    // the last timestamp of that PDU
+	unsigned steps;                 // steps on the grid in a row
+	uint64_t run_ts;                // the first stamp of the current run, and
+	uint64_t run_events;            // the events since it, at the nominal step
+};
+
+static void *crf_rx_main(void *arg)
+{
+	struct crf_rx *x = arg;
+	const struct crf_rx_cfg *c = &x->cfg;
+	struct milan_media_crf rep;
+	memset(&rep, 0, sizeof rep);
+	rep.margin_min_ns = INT32_MAX;
+	rep.milan.valid = MILAN_SI_VALID;       // this thread counts all ten (media.h)
+	struct milan_obs obs;
+	milan_counters_zero(&rep.milan, &obs, 0, milan_mono_ns());
+	live_update(x, &rep);
+
+	int ifindex = (int)if_nametoindex(c->ifname);
+	int fd = socket(AF_PACKET, SOCK_RAW | SOCK_CLOEXEC, htons(ETH_P_ALL));
+	struct sockaddr_ll sll = {.sll_family = AF_PACKET, .sll_protocol = htons(ETH_P_ALL), .sll_ifindex = ifindex};
+	struct timeval tv = {0, 5000};
+	if (fd < 0 || ifindex == 0 || set_filter(fd, 0) != 0 || bind(fd, (struct sockaddr *)&sll, sizeof sll) != 0 ||
+	    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv) != 0) {
+		// no receive path: nothing counts the input, so none of its counters is valid
+		rep.milan.valid = 0;
+		live_update(x, &rep);
+		if (fd >= 0) {
+			close(fd);
+		}
+		return NULL;
+	}
+	int one = 1;
+	(void)setsockopt(fd, SOL_PACKET, PACKET_IGNORE_OUTGOING, &one, sizeof one);
+
+	// the nominal step between two timestamps of the Milan format, in ns:
+	// timestamp_interval events at base_frequency (pull 0)
+	const uint64_t step_ns = (uint64_t)CRF_MILAN_INTERVAL * 1000000000u / CRF_MILAN_BASE_FREQUENCY;
+
+	enum cstate state = C_NONE;
+	uint64_t cur_stream = 0, cur_mac = 0;
+	bool have_seq = false, have_mr = false, last_mr = false;
+	uint8_t last_seq = 0;
+	struct grid g = {0};
+	int64_t last_rx = 0, next_check = 0, next_report = 0;
+	uint8_t frame[2048];
+
+	while (!atomic_load(&x->stop)) {
+		bool publish = milan_obs_close(&obs, &rep.milan, milan_mono_ns());
+		int64_t now = gptp_now(c->clk);
+		if (now >= next_check) {
+			next_check = now + CHECK_NS;
+			struct milan_dp_sink k;
+			bool read = sink_of(x, &k);
+			bool listening = read && k.listening;
+			bool rebound = read && k.binds != rep.milan.binds;
+			if (rebound || !listening || k.stream_id != cur_stream || k.dest_mac != cur_mac) {
+				if (state != C_NONE) {
+					membership(fd, ifindex, cur_mac, false);
+					set_locked(&rep, false);
+					rep.active = 0;
+				}
+				if (rebound) {
+					milan_counters_zero(&rep.milan, &obs, 0, milan_mono_ns());
+					rep.milan.binds = k.binds;
+				}
+				state = C_NONE;
+				cur_stream = cur_mac = 0;
+				set_filter(fd, 0);
+				if (listening) {
+					cur_stream = k.stream_id;
+					cur_mac = k.dest_mac;
+					set_filter(fd, k.dest_mac);
+					membership(fd, ifindex, k.dest_mac, true);
+					rep.stream_id = k.stream_id;
+					state = C_WAITING;
+					have_seq = have_mr = false;
+					g.have = false;
+				}
+				publish = true;
+			}
+		}
+		bool report = now >= next_report;
+		if (publish || report) {
+			live_update(x, &rep);
+		}
+		if (report) {
+			// the interval figures start over for the next report
+			next_report = now + REPORT_NS;
+			rep.step_err_max_ns = 0;
+			rep.margin_min_ns = INT32_MAX;
+		}
+
+		ssize_t n = recv(fd, frame, sizeof frame, 0);
+		now = gptp_now(c->clk);
+		struct crf_pdu pdu;
+		bool ours = n > 0 && state != C_NONE && crf_parse(frame, (size_t)n, &pdu) && pdu.stream_id == cur_stream;
+		if (!ours || !crf_is_milan(&pdu)) {
+			// no Milan PDU of the stream for interrupt_ns, PDUs of another format
+			// arriving or none: a timeout can race PDUs that came while this thread
+			// waited to run, and with any waiting the stream was not interrupted
+			uint8_t peek;
+			bool pending = n <= 0 && recv(fd, &peek, 1, MSG_PEEK | MSG_DONTWAIT) > 0;
+			if (state == C_RUNNING && !pending && now - last_rx > c->interrupt_ns) {
+				rep.stream_interrupted++;
+				rep.milan.value[MILAN_SI_STREAM_INTERRUPTED]++;
+				set_locked(&rep, false);
+				rep.active = 0;
+				state = C_WAITING;
+				have_seq = false;
+				g.have = false;
+				live_update(x, &rep);
+			}
+			if (!ours) {
+				continue;
+			}
+		}
+		// received, whatever is in it; then its header, as the AAF listener reads one
+		rep.pdus++;
+		milan_obs_note(&obs, MILAN_SI_FRAMES_RX);
+		bool skipped = have_seq && pdu.seq != (uint8_t)(last_seq + 1u);
+		if (skipped) {
+			rep.seq_mismatch++;
+			milan_obs_note(&obs, MILAN_SI_SEQ_NUM_MISMATCH);
+		}
+		last_seq = pdu.seq;
+		have_seq = true;
+		bool restart = have_mr && pdu.mr != last_mr;
+		last_mr = pdu.mr;
+		have_mr = true;
+		if (restart) {
+			rep.media_restarts++;
+			milan_obs_note(&obs, MILAN_SI_MEDIA_RESET);
+		}
+		if (pdu.tu) {
+			rep.timestamp_uncertain++;
+			milan_obs_note(&obs, MILAN_SI_TIMESTAMP_UNCERTAIN);
+		}
+		if (!crf_is_milan(&pdu)) {
+			rep.unsupported_format++;
+			milan_obs_note(&obs, MILAN_SI_UNSUPPORTED_FORMAT);
+			continue;
+		}
+		// each timestamp, a presentation time (crf_rx.h)
+		int64_t margin = (int64_t)(pdu.timestamps[0] - (uint64_t)now);
+		if (margin < 0) {
+			rep.late_timestamp++;
+			milan_obs_note(&obs, MILAN_SI_LATE_TIMESTAMP);
+		} else if (margin > c->early_ns) {
+			// too far in the future to process: counted, and not laid on the grid
+			rep.early_timestamp++;
+			milan_obs_note(&obs, MILAN_SI_EARLY_TIMESTAMP);
+			continue;
+		}
+		int32_t m32 = margin < INT32_MIN ? INT32_MIN : margin > INT32_MAX ? INT32_MAX : (int32_t)margin;
+		rep.margin_min_ns = m32 < rep.margin_min_ns ? m32 : rep.margin_min_ns;
+		last_rx = now;
+		state = C_RUNNING;
+		rep.active = 1;
+
+		// the grid: a restart or an uncertain stamp starts it over
+		if (restart) {
+			set_locked(&rep, false);
+			g.have = false;
+		}
+		uint64_t ts = pdu.timestamps[0];
+		if (pdu.tu || !g.have) {
+			g = (struct grid){.have = !pdu.tu, .seq = pdu.seq, .ts = ts, .run_ts = ts};
+			continue;
+		}
+		uint8_t dseq = (uint8_t)(pdu.seq - g.seq);
+		int64_t err = (int64_t)(ts - g.ts) - (int64_t)(dseq * step_ns);
+		int64_t abs_err = err < 0 ? -err : err;
+		rep.step_err_max_ns = abs_err > rep.step_err_max_ns ? (int32_t)(abs_err > INT32_MAX ? INT32_MAX : abs_err)
+								 : rep.step_err_max_ns;
+		if (dseq == 0u || abs_err > CRF_RX_STEP_TOL_NS) {
+			// off the grid: the clock this stream carries is not the one it was
+			rep.grid_breaks++;
+			set_locked(&rep, false);
+			g = (struct grid){.have = true, .seq = pdu.seq, .ts = ts, .run_ts = ts};
+			continue;
+		}
+		g.seq = pdu.seq;
+		g.ts = ts;
+		g.steps++;
+		g.run_events += dseq;
+		if (g.steps >= CRF_RX_LOCK_STEPS && !rep.locked) {
+			set_locked(&rep, true);
+		}
+		if (g.run_events > 0u) {
+			double nominal = (double)g.run_events * (double)step_ns;
+			rep.rate_ppb = (int64_t)(((double)(ts - g.run_ts) / nominal - 1.0) * 1e9);
+		}
+	}
+	close(fd);
+	return NULL;
+}
+
+int crf_rx_start(struct crf_rx *x, const struct crf_rx_cfg *cfg)
+{
+	memset(x, 0, sizeof *x);
+	x->cfg = *cfg;
+	pthread_attr_t attr;
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, 256u * 1024u);
+	if (cfg->rt_priority > 0) {
+		struct sched_param sp = {.sched_priority = cfg->rt_priority};
+		pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);
+		pthread_attr_setschedpolicy(&attr, SCHED_FIFO);
+		pthread_attr_setschedparam(&attr, &sp);
+	}
+	if (cfg->cpu >= 0) {
+		cpu_set_t set;
+		CPU_ZERO(&set);
+		CPU_SET(cfg->cpu, &set);
+		pthread_attr_setaffinity_np(&attr, sizeof set, &set);
+	}
+	int rc = pthread_create(&x->thread, &attr, crf_rx_main, x);
+	pthread_attr_destroy(&attr);
+	return rc;
+}
+
+void crf_rx_stop(struct crf_rx *x)
+{
+	atomic_store(&x->stop, true);
+	pthread_join(x->thread, NULL);
+}
diff --git a/milan-linux/src/crf_rx.h b/milan-linux/src/crf_rx.h
new file mode 100644
index 0000000..6a1ff9e
--- /dev/null
+++ b/milan-linux/src/crf_rx.h
@@ -0,0 +1,77 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Kebag-Logic
+// SPDX-License-Identifier: Apache-2.0
+//
+// crf_rx.h - the CRF Media Clock Input's receive path (STREAM_INPUT 1, Milan
+// v1.2 7.2.2): it receives the CRF stream milan-ctrld settled the sink on,
+// tracks the media clock the stream carries, and counts it. Nothing on the
+// board clocks from that media clock: milan-mediad's talker and listener
+// keep their own gPTP-derived clock whatever CLOCK_SOURCE says
+// (AECP-STATUS.md). What this path does is what the stream's counters need.
+//
+// A PDU of the bound stream is received (FRAMES_RX) whatever is in it. Its
+// header is read as the AAF listener reads its own: a non-sequential
+// sequence_num, a toggled mr (a media clock restart, IEEE 1722-2016 10.4.3), a
