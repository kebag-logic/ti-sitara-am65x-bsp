# KL TDM8 -> USB Audio Class 2.0 gadget fragment for the MYIR AM6254
#
# Merge onto the board's own config (see README.tdm8-uac2.md):
#   scripts/kconfig/merge_config.sh -m linux/.config res/kl-tdm8-uac2.config
#
# The board's running config already carries McASP, simple-audio-card, DWC3/AM62,
# f_uac2, f_ecm and configfs as modules, so the only genuinely NEW symbol here is
# SND_SOC_KL_TDM8_DUMMY. Everything else is pinned so a later olddefconfig or a
# kernel-version bump cannot silently drop it.

# --- The control-less 8-slot TDM peer shim (res/tdm8/kl-tdm8-dummy.c) ---
CONFIG_SND_SOC_KL_TDM8_DUMMY=m

# --- ASoC machine driver that binds the /sound-tdm8 simple-audio-card node ---
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SIMPLE_CARD_UTILS=m

# --- McASP + its UDMA PCM backend ---
CONFIG_SND_SOC=m
CONFIG_SND_SOC_DAVINCI_MCASP=m
CONFIG_SND_SOC_TI_UDMA_PCM=m
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y

# --- USB Audio Class 2.0 *gadget* side ---
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_F_UAC2=m
CONFIG_USB_U_AUDIO=m
CONFIG_CONFIGFS_FS=y

# --- keep the ECM management link that shares the same composite gadget ---
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=m

# --- AM62x DWC3 dual-role controller behind the USB-C OTG port (J15/J10) ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AM62=y
CONFIG_USB_DWC3_DUAL_ROLE=y

# --- ALSA plumbing the alsaloop bridge needs ---
CONFIG_SND_PCM=m
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_MAX_CARDS=32

# --- A stable, self-identifying kernel release ---
# The board config has CONFIG_LOCALVERSION_AUTO=y, which appends the git hash and
# "-dirty" and so renames /lib/modules on every rebuild. Pin it: `uname -r` then
# says 7.1.0-tdm8 and the TDM8 kernel's modules never collide with 7.1.0-dirty.
CONFIG_LOCALVERSION="-tdm8"
# CONFIG_LOCALVERSION_AUTO is not set
