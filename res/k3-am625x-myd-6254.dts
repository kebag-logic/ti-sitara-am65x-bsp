				ethernet-phy@1 {
					reg = <0x01>;
					reset-gpios = <0x21 0x06 0x01>;
					reset-assert-us = <0x2710>;
					reset-deassert-us = <0x4e20>;
					phandle = <0x3b>;
				};
			};

			cpts@3d000 {
				compatible = "ti,j721e-cpts";
				reg = <0x00 0x3d000 0x00 0x400>;
