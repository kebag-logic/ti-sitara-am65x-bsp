		compatible = "gpio-leds";

		led-user {
			label = "am62-sk:d54";
			gpios = <0x21 0x04 0x01>;
			max-brightness = <0xff>;
			linux,default-trigger = "heartbeat";
			function = "heartbeat";
			default-state = "off";
		};

		led-sys {
			label = "am62-sk:d53";
			pinctrl-names = "default";
			pinctrl-1 = <0x09>;
			gpios = <0x51 0x10 0x01>;
			linux,default-trigger = "heartbeat";
			function = "heartbeat";
			default-state = "on";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <0x58>;

		user {
			label = "GPIO Key USER1";
			linux,code = <0x100>;
			gpios = <0x1a 0x24 0x01>;
		};
	};
};
