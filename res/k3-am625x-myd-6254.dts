/dts-v1/;

/ {
	model = "Texas Instruments K3 AM625 SoC";
	compatible = "ti,am625";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	chosen {
		stdout-path = "serial2:115200n8";
		bootargs = "console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000";
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};
	};

	timer-cl0-cpu0 {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x01 0x07 0x04>;
	};

	bus@f0000 {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0xf0000 0x00 0xf0000 0x00 0x30000 0x00 0x420000 0x00 0x420000 0x00 0x1000 0x00 0x600000 0x00 0x600000 0x00 0x1100 0x00 0x703000 0x00 0x703000 0x00 0x200 0x00 0x70c000 0x00 0x70c000 0x00 0x200 0x00 0xa40000 0x00 0xa40000 0x00 0x800 0x00 0x1000000 0x00 0x1000000 0x00 0x1b28400 0x00 0x8000000 0x00 0x8000000 0x00 0x200000 0x00 0xe000000 0x00 0xe000000 0x00 0x1d20000 0x00 0xfd00000 0x00 0xfd00000 0x00 0x20000 0x00 0x20000000 0x00 0x20000000 0x00 0xa008000 0x00 0x30040000 0x00 0x30040000 0x00 0x80000 0x00 0x30101000 0x00 0x30101000 0x00 0x10100 0x00 0x30200000 0x00 0x30200000 0x00 0x10000 0x00 0x31000000 0x00 0x31000000 0x00 0x50000 0x00 0x31100000 0x00 0x31100000 0x00 0x50000 0x00 0x3b000000 0x00 0x3b000000 0x00 0x400 0x00 0x40900000 0x00 0x40900000 0x00 0x30000 0x00 0x43600000 0x00 0x43600000 0x00 0x10000 0x00 0x44043000 0x00 0x44043000 0x00 0xfe0 0x00 0x44860000 0x00 0x44860000 0x00 0x40000 0x00 0x48000000 0x00 0x48000000 0x00 0x6400000 0x00 0x50000000 0x00 0x50000000 0x00 0x8000000 0x00 0x60000000 0x00 0x60000000 0x00 0x8000000 0x00 0x70000000 0x00 0x70000000 0x00 0x10000 0x01 0x00 0x01 0x00 0x00 0x310000 0x05 0x00 0x05 0x00 0x01 0x00 0x00 0x4000000 0x00 0x4000000 0x00 0x1ff1400 0x00 0xb00000 0x00 0xb00000 0x00 0x2400 0x00 0x2b000000 0x00 0x2b000000 0x00 0x300400 0x00 0x43000000 0x00 0x43000000 0x00 0x20000 0x00 0x78000000 0x00 0x78000000 0x00 0x8000 0x00 0x78100000 0x00 0x78100000 0x00 0x8000>;

		bus@4000000 {
			bootph-all;
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x4000000 0x00 0x4000000 0x00 0x1ff1400>;

			pinctrl@4084000 {
				bootph-all;
				compatible = "pinctrl-single";
				reg = <0x00 0x4084000 0x00 0x88>;
				#pinctrl-cells = <0x01>;
				pinctrl-single,register-width = <0x20>;
				pinctrl-single,function-mask = <0xffffffff>;

				mcu-i2c0-pins-default {
					pinctrl-single,pins = <0x44 0x50000 0x48 0x50000>;
					phandle = <0x04>;
				};

				mcu-wl-reg-on-pins-default {
					pinctrl-single,pins = <0x3c 0x20007>;
					phandle = <0x07>;
				};

				mcu-lvds-power-pins-default {
					pinctrl-single,pins = <0x10 0x20007>;
					phandle = <0x08>;
				};

				csi-io-power-pins-default {
					pinctrl-single,pins = <0x0c 0x10007>;
					phandle = <0x53>;
				};

				mymcugpio1-pins-default {
					pinctrl-single,pins = <0x40 0x50007>;
					phandle = <0x09>;
				};

				mcu-ov5640-gpio-pins-default {
					pinctrl-single,pins = <0x00 0x10007 0x08 0x10007>;
				};
			};

			esm@4100000 {
				bootph-pre-ram;
				compatible = "ti,j721e-esm";
				reg = <0x00 0x4100000 0x00 0x1000>;
				ti,esm-pins = <0x00 0x01 0x02 0x55>;
			};

			timer@4800000 {
				compatible = "ti,am654-timer";
				reg = <0x00 0x4800000 0x00 0x400>;
				clocks = <0x02 0x23 0x02>;
				clock-names = "fck";
				power-domains = <0x03 0x23 0x01>;
				ti,timer-pwm;
				status = "reserved";
			};

			timer@4810000 {
				compatible = "ti,am654-timer";
				reg = <0x00 0x4810000 0x00 0x400>;
				clocks = <0x02 0x30 0x02>;
				clock-names = "fck";
				power-domains = <0x03 0x30 0x01>;
				ti,timer-pwm;
				status = "reserved";
			};

			timer@4820000 {
				compatible = "ti,am654-timer";
				reg = <0x00 0x4820000 0x00 0x400>;
				clocks = <0x02 0x31 0x02>;
				clock-names = "fck";
				power-domains = <0x03 0x31 0x01>;
				ti,timer-pwm;
				status = "reserved";
			};

			timer@4830000 {
				compatible = "ti,am654-timer";
				reg = <0x00 0x4830000 0x00 0x400>;
				clocks = <0x02 0x32 0x02>;
				clock-names = "fck";
				power-domains = <0x03 0x32 0x01>;
				ti,timer-pwm;
				status = "reserved";
			};

			serial@4a00000 {
				compatible = "ti,am64-uart", "ti,am654-uart";
				reg = <0x00 0x4a00000 0x00 0x100>;
				interrupts = <0x00 0xb9 0x04>;
				power-domains = <0x03 0x95 0x01>;
				clocks = <0x02 0x95 0x00>;
				clock-names = "fclk";
				status = "disabled";
			};

			i2c@4900000 {
				compatible = "ti,am64-i2c", "ti,omap4-i2c";
				reg = <0x00 0x4900000 0x00 0x100>;
				interrupts = <0x00 0x6b 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				power-domains = <0x03 0x6a 0x01>;
				clocks = <0x02 0x6a 0x02>;
				clock-names = "fck";
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <0x04>;
				clock-frequency = <0x61a80>;

				24c32@50 {
					compatible = "atmel,24c32";
					reg = <0x50>;
					pagesize = <0x20>;
				};
			};

			spi@4b00000 {
				compatible = "ti,am654-mcspi", "ti,omap4-mcspi";
				reg = <0x00 0x4b00000 0x00 0x400>;
				interrupts = <0x00 0xb0 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				power-domains = <0x03 0x93 0x01>;
				clocks = <0x02 0x93 0x00>;
				status = "disabled";
			};

			spi@4b10000 {
				compatible = "ti,am654-mcspi", "ti,omap4-mcspi";
				reg = <0x00 0x4b10000 0x00 0x400>;
				interrupts = <0x00 0xb1 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				power-domains = <0x03 0x94 0x01>;
				clocks = <0x02 0x94 0x00>;
				status = "disabled";
			};

			interrupt-controller@4210000 {
				compatible = "ti,sci-intr";
				reg = <0x00 0x4210000 0x00 0x200>;
				ti,intr-trigger-type = <0x01>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				#interrupt-cells = <0x01>;
				ti,sci = <0x05>;
				ti,sci-dev-id = <0x05>;
				ti,interrupt-ranges = <0x00 0x68 0x04>;
				phandle = <0x06>;
			};

			gpio@4201000 {
				compatible = "ti,am64-gpio", "ti,keystone-gpio";
				reg = <0x00 0x4201000 0x00 0x100>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-parent = <0x06>;
				interrupts = <0x1e 0x1f>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				ti,ngpio = <0x18>;
				ti,davinci-gpio-unbanked = <0x00>;
				power-domains = <0x03 0x4f 0x01>;
				clocks = <0x02 0x4f 0x00>;
				clock-names = "gpio";
				pinctrl-names = "default";
				pinctrl-0 = <0x07 0x08 0x09>;
				status = "okay";
				phandle = <0x51>;
			};

			watchdog@4880000 {
				compatible = "ti,j7-rti-wdt";
				reg = <0x00 0x4880000 0x00 0x100>;
				clocks = <0x02 0x83 0x00>;
				power-domains = <0x03 0x83 0x01>;
				assigned-clocks = <0x02 0x83 0x00>;
				assigned-clock-parents = <0x02 0x83 0x02>;
				status = "reserved";
			};

			can@4e08000 {
				compatible = "bosch,m_can";
				reg = <0x00 0x4e08000 0x00 0x200 0x00 0x4e00000 0x00 0x8000>;
				reg-names = "m_can", "message_ram";
				power-domains = <0x03 0xbc 0x01>;
				clocks = <0x02 0xbc 0x06 0x02 0xbc 0x01>;
				clock-names = "hclk", "cclk";
				bosch,mram-cfg = <0x00 0x80 0x40 0x40 0x40 0x40 0x20 0x20>;
				status = "disabled";
			};

			can@4e18000 {
				compatible = "bosch,m_can";
				reg = <0x00 0x4e18000 0x00 0x200 0x00 0x4e10000 0x00 0x8000>;
				reg-names = "m_can", "message_ram";
				power-domains = <0x03 0xbd 0x01>;
				clocks = <0x02 0xbd 0x06 0x02 0xbd 0x01>;
				clock-names = "hclk", "cclk";
				bosch,mram-cfg = <0x00 0x80 0x40 0x40 0x40 0x40 0x20 0x20>;
				status = "disabled";
			};

			m4fss@5000000 {
				compatible = "ti,am64-m4fss";
				reg = <0x00 0x5000000 0x00 0x30000 0x00 0x5040000 0x00 0x10000>;
				reg-names = "iram", "dram";
				resets = <0x0a 0x09 0x01>;
				firmware-name = "am62-mcu-m4f0_0-fw";
				ti,sci = <0x05>;
				ti,sci-dev-id = <0x09>;
				ti,sci-proc-ids = <0x18 0xff>;
				status = "disabled";
				mboxes = <0x0b 0x0c>;
				memory-region = <0x0d 0x0e>;
			};
		};

		bus@b00000 {
			bootph-all;
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0xb00000 0x00 0xb00000 0x00 0x2400 0x00 0x2b000000 0x00 0x2b000000 0x00 0x300400 0x00 0x43000000 0x00 0x43000000 0x00 0x20000 0x00 0x78000000 0x00 0x78000000 0x00 0x8000 0x00 0x78100000 0x00 0x78100000 0x00 0x8000>;

			bus@43000000 {
				bootph-all;
				compatible = "simple-bus";
				reg = <0x00 0x43000000 0x00 0x20000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x00 0x43000000 0x20000>;

				chipid@14 {
					bootph-all;
					compatible = "ti,am654-chipid";
					reg = <0x14 0x04>;
				};

				syscon@18 {
					compatible = "ti,am62-opp-efuse-table", "syscon";
					reg = <0x18 0x04>;
					phandle = <0x4f>;
				};

				ethernet-mac-syscon@200 {
					compatible = "ti,am62p-cpsw-mac-efuse", "syscon";
					reg = <0x200 0x08>;
					phandle = <0x39>;
				};

				syscon@4008 {
					compatible = "ti,am62-usb-phy-ctrl", "syscon";
					reg = <0x4008 0x04>;
					phandle = <0x32>;
				};

				syscon@4018 {
					compatible = "ti,am62-usb-phy-ctrl", "syscon";
					reg = <0x4018 0x04>;
					phandle = <0x34>;
				};
			};

			target-module@2b300050 {
				compatible = "ti,sysc-omap2", "ti,sysc";
				reg = <0x00 0x2b300050 0x00 0x04 0x00 0x2b300054 0x00 0x04 0x00 0x2b300058 0x00 0x04>;
				reg-names = "rev", "sysc", "syss";
				ti,sysc-mask = <0x07>;
				ti,sysc-sidle = <0x00 0x01 0x02 0x03>;
				ti,syss-mask = <0x01>;
				ti,no-reset-on-init;
				power-domains = <0x03 0x72 0x01>;
				clocks = <0x02 0x72 0x00>;
				clock-names = "fck";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x00 0x2b300000 0x100000>;

				serial@0 {
					compatible = "ti,am64-uart", "ti,am654-uart";
					reg = <0x00 0x100>;
					interrupts = <0x00 0xba 0x04>;
					status = "reserved";
				};
			};

			i2c@2b200000 {
				compatible = "ti,am64-i2c", "ti,omap4-i2c";
				reg = <0x00 0x2b200000 0x00 0x100>;
				interrupts = <0x00 0xa5 0x04>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				power-domains = <0x03 0x6b 0x01>;
				clocks = <0x02 0x6b 0x04>;
				clock-names = "fck";
				status = "disabled";
			};

			rtc@2b1f0000 {
				compatible = "ti,am62-rtc";
				reg = <0x00 0x2b1f0000 0x00 0x100>;
				interrupts = <0x00 0x64 0x04>;
				clocks = <0x02 0x75 0x06 0x02 0x75 0x00>;
				clock-names = "vbus", "osc32k";
				power-domains = <0x03 0x75 0x01>;
				wakeup-source;
			};

			watchdog@2b000000 {
				compatible = "ti,j7-rti-wdt";
				reg = <0x00 0x2b000000 0x00 0x100>;
				clocks = <0x02 0x84 0x00>;
				power-domains = <0x03 0x84 0x01>;
				assigned-clocks = <0x02 0x84 0x00>;
				assigned-clock-parents = <0x02 0x84 0x02>;
				status = "reserved";
			};

			r5fss@78000000 {
				compatible = "ti,am62-r5fss";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x78000000 0x00 0x78000000 0x8000 0x78100000 0x00 0x78100000 0x8000>;
				power-domains = <0x03 0x77 0x01>;
				status = "disabled";

				r5f@78000000 {
					compatible = "ti,am62-r5f";
					reg = <0x78000000 0x8000 0x78100000 0x8000>;
					reg-names = "atcm", "btcm";
					resets = <0x0a 0x79 0x01>;
					firmware-name = "am62-wkup-r5f0_0-fw";
					ti,atcm-enable = <0x01>;
					ti,btcm-enable = <0x01>;
					ti,loczrama = <0x01>;
					ti,sci = <0x05>;
					ti,sci-dev-id = <0x79>;
					ti,sci-proc-ids = <0x01 0xff>;
					mboxes = <0x0b 0x0f>;
					memory-region = <0x10 0x11>;
				};
			};

			temperature-sensor@b00000 {
				compatible = "ti,j7200-vtm";
				reg = <0x00 0xb00000 0x00 0x400 0x00 0xb01000 0x00 0x400>;
				power-domains = <0x03 0x5f 0x01>;
				#thermal-sensor-cells = <0x01>;
				phandle = <0x46>;
			};
		};

		sram@70000000 {
			compatible = "mmio-sram";
			reg = <0x00 0x70000000 0x00 0x10000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x70000000 0x10000>;
		};

		interrupt-controller@1800000 {
			compatible = "arm,gic-v3";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			reg = <0x00 0x1800000 0x00 0x10000 0x00 0x1880000 0x00 0xc0000 0x01 0x00 0x00 0x2000 0x01 0x10000 0x00 0x1000 0x01 0x20000 0x00 0x2000>;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;

			msi-controller@1820000 {
				compatible = "arm,gic-v3-its";
				reg = <0x00 0x1820000 0x00 0x10000>;
				socionext,synquacer-pre-its = <0x1000000 0x400000>;
				msi-controller;
				#msi-cells = <0x01>;
			};
		};

		bus@100000 {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x100000 0x20000>;

			phy@4044 {
				compatible = "ti,am654-phy-gmii-sel";
				reg = <0x4044 0x08>;
				#phy-cells = <0x01>;
				phandle = <0x38>;
			};

			clock-controller@4130 {
				compatible = "ti,am62-epwm-tbclk";
				reg = <0x4130 0x04>;
				#clock-cells = <0x01>;
				phandle = <0x40>;
			};

			clock-controller@82e0 {
				compatible = "ti,am62-audio-refclk";
				reg = <0x82e0 0x04>;
				clocks = <0x02 0x9d 0x00>;
				assigned-clocks = <0x02 0x9d 0x00>;
				assigned-clock-parents = <0x02 0x9d 0x08>;
				#clock-cells = <0x00>;
			};

			clock-controller@82e4 {
				compatible = "ti,am62-audio-refclk";
				reg = <0x82e4 0x04>;
				clocks = <0x02 0x9d 0x0a>;
				assigned-clocks = <0x02 0x9d 0x0a>;
				assigned-clock-parents = <0x02 0x9d 0x12>;
				#clock-cells = <0x00>;
			};
		};

		bus@48000000 {
			bootph-all;
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			dma-ranges;
			ranges = <0x00 0x48000000 0x00 0x48000000 0x00 0x6400000>;
			ti,sci-dev-id = <0x19>;

			mailbox@4d000000 {
				bootph-all;
				compatible = "ti,am654-secure-proxy";
				#mbox-cells = <0x01>;
				reg-names = "target_data", "rt", "scfg";
				reg = <0x00 0x4d000000 0x00 0x80000 0x00 0x4a600000 0x00 0x80000 0x00 0x4a400000 0x00 0x80000>;
				interrupt-names = "rx_012";
				interrupts = <0x00 0x22 0x04>;
				phandle = <0x15>;
			};

			interrupt-controller@48000000 {
				compatible = "ti,sci-inta";
				reg = <0x00 0x48000000 0x00 0x100000>;
				#interrupt-cells = <0x00>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				msi-controller;
				ti,sci = <0x05>;
				ti,sci-dev-id = <0x1c>;
				ti,interrupt-ranges = <0x04 0x44 0x24>;
				ti,unmapped-event-sources = <0x12 0x13>;
				phandle = <0x14>;
			};

			dma-controller@485c0100 {
				compatible = "ti,am64-dmss-bcdma";
				reg = <0x00 0x485c0100 0x00 0x100 0x00 0x4c000000 0x00 0x20000 0x00 0x4a820000 0x00 0x20000 0x00 0x4aa40000 0x00 0x20000 0x00 0x4bc00000 0x00 0x100000 0x00 0x48600000 0x00 0x8000 0x00 0x484a4000 0x00 0x2000 0x00 0x484c2000 0x00 0x2000 0x00 0x48420000 0x00 0x2000>;
				reg-names = "gcfg", "bchanrt", "rchanrt", "tchanrt", "ringrt", "ring", "tchan", "rchan", "bchan";
				msi-parent = <0x14>;
				#dma-cells = <0x03>;
				ti,sci = <0x05>;
				ti,sci-dev-id = <0x1a>;
				ti,sci-rm-range-bchan = <0x20>;
				ti,sci-rm-range-rchan = <0x21>;
				ti,sci-rm-range-tchan = <0x22>;
				phandle = <0x12>;
			};

			dma-controller@485c0000 {
				compatible = "ti,am64-dmss-pktdma";
				reg = <0x00 0x485c0000 0x00 0x100 0x00 0x4a800000 0x00 0x20000 0x00 0x4aa00000 0x00 0x20000 0x00 0x4b800000 0x00 0x200000 0x00 0x485e0000 0x00 0x10000 0x00 0x484a0000 0x00 0x2000 0x00 0x484c0000 0x00 0x2000 0x00 0x48430000 0x00 0x1000>;
				reg-names = "gcfg", "rchanrt", "tchanrt", "ringrt", "ring", "tchan", "rchan", "rflow";
				msi-parent = <0x14>;
				#dma-cells = <0x02>;
				ti,sci = <0x05>;
				ti,sci-dev-id = <0x1e>;
				ti,sci-rm-range-tchan = <0x23 0x24 0x25 0x26>;
				ti,sci-rm-range-tflow = <0x10 0x11 0x12 0x13>;
				ti,sci-rm-range-rchan = <0x29 0x2b 0x2d 0x2f 0x31 0x33>;
				ti,sci-rm-range-rflow = <0x2a 0x2c 0x2e 0x32>;
				phandle = <0x13>;
			};
		};

		system-controller@44043000 {
			bootph-all;
			compatible = "ti,k2g-sci";
			ti,host-id = <0x0c>;
