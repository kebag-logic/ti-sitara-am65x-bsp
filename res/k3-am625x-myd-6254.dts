			clocks = <0x02 0xbf 0x00>;
			clock-names = "fck";
			assigned-clocks = <0x02 0xbf 0x00>;
			assigned-clock-parents = <0x02 0xbf 0x02>;
			power-domains = <0x03 0xbf 0x01>;
			status = "disabled";
		};

		audio-controller@2b20000 {
			compatible = "ti,am33xx-mcasp-audio";
			reg = <0x00 0x2b20000 0x00 0x2000 0x00 0x2b28000 0x00 0x400>;
			reg-names = "mpu", "dat";
			interrupts = <0x00 0xf0 0x04 0x00 0xef 0x04>;
			interrupt-names = "tx", "rx";
			dmas = <0x12 0x00 0xc502 0x00 0x12 0x00 0x4502 0x00>;
			dma-names = "tx", "rx";
			clocks = <0x02 0xc0 0x00>;
			clock-names = "fck";
			assigned-clocks = <0x02 0xc0 0x00>;
			assigned-clock-parents = <0x02 0xc0 0x02>;
			power-domains = <0x03 0xc0 0x01>;
			status = "disabled";
		};

		ticsi2rx@30102000 {
			compatible = "ti,j721e-csi2rx-shim";
			dmas = <0x12 0x00 0x4700 0x00>;
			dma-names = "rx0";
			reg = <0x00 0x30102000 0x00 0x1000>;
			power-domains = <0x03 0xb6 0x01>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			status = "disabled";

			csi-bridge@30101000 {
				compatible = "ti,j721e-csi2rx", "cdns,csi2rx";
				reg = <0x00 0x30101000 0x00 0x1000>;
				clocks = <0x02 0xb6 0x00 0x02 0xb6 0x03 0x02 0xb6 0x00 0x02 0xb6 0x00 0x02 0xb6 0x04 0x02 0xb6 0x04>;
				clock-names = "sys_clk", "p_clk", "pixel_if0_clk", "pixel_if1_clk", "pixel_if2_clk", "pixel_if3_clk";
				phys = <0x42>;
				phy-names = "dphy";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;
						status = "disabled";
					};

					port@1 {
						reg = <0x01>;
						status = "disabled";
					};

					port@2 {
						reg = <0x02>;
						status = "disabled";
					};

					port@3 {
						reg = <0x03>;
						status = "disabled";
					};

					port@4 {
						reg = <0x04>;
						status = "disabled";
					};
				};
			};
		};

		phy@30110000 {
			compatible = "cdns,dphy-rx";
			reg = <0x00 0x30110000 0x00 0x1100>;
			#phy-cells = <0x00>;
			power-domains = <0x03 0xb9 0x01>;
			status = "okay";
			phandle = <0x42>;
		};

		pruss@30040000 {
			compatible = "ti,am625-pruss";
			reg = <0x00 0x30040000 0x00 0x80000>;
			power-domains = <0x03 0x51 0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x30040000 0x80000>;

			memories@0 {
				reg = <0x00 0x2000 0x2000 0x2000 0x10000 0x10000>;
				reg-names = "dram0", "dram1", "shrdram2";
			};

			cfg@26000 {
				compatible = "ti,pruss-cfg", "syscon";
				reg = <0x26000 0x200>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x26000 0x2000>;

				clocks {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					coreclk-mux@3c {
						reg = <0x3c>;
						#clock-cells = <0x00>;
						clocks = <0x02 0x51 0x00 0x02 0x51 0x0e>;
						assigned-clocks = <0x43>;
						assigned-clock-parents = <0x02 0x51 0x0e>;
						phandle = <0x43>;
					};

					iepclk-mux@30 {
						reg = <0x30>;
						#clock-cells = <0x00>;
						clocks = <0x02 0x51 0x03 0x43>;
						assigned-clocks = <0x44>;
						assigned-clock-parents = <0x43>;
						phandle = <0x44>;
					};
				};
			};

			interrupt-controller@20000 {
				compatible = "ti,pruss-intc";
				reg = <0x20000 0x2000>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				interrupts = <0x00 0x58 0x04 0x00 0x59 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04 0x00 0x5c 0x04 0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04>;
				interrupt-names = "host_intr0", "host_intr1", "host_intr2", "host_intr3", "host_intr4", "host_intr5", "host_intr6", "host_intr7";
				phandle = <0x45>;
			};

			pru@34000 {
				compatible = "ti,am625-pru";
				reg = <0x34000 0x3000 0x22000 0x100 0x22400 0x100>;
				reg-names = "iram", "control", "debug";
				firmware-name = "am62x-pru0-fw";
				interrupt-parent = <0x45>;
				interrupts = <0x10 0x02 0x02>;
				interrupt-names = "vring";
			};

			pru@38000 {
				compatible = "ti,am625-pru";
				reg = <0x38000 0x3000 0x24000 0x100 0x24400 0x100>;
				reg-names = "iram", "control", "debug";
				firmware-name = "am62x-pru1-fw";
				interrupt-parent = <0x45>;
				interrupts = <0x12 0x03 0x03>;
				interrupt-names = "vring";
			};
		};

		memory-controller@3b000000 {
			compatible = "ti,am64-gpmc";
			power-domains = <0x03 0x50 0x01>;
			clocks = <0x02 0x50 0x00>;
			clock-names = "fck";
			reg = <0x00 0x3b000000 0x00 0x400 0x00 0x50000000 0x00 0x8000000>;
			reg-names = "cfg", "data";
			interrupts = <0x00 0x6a 0x04>;
			gpmc,num-cs = <0x03>;
			gpmc,num-waitpins = <0x02>;
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			gpio-controller;
			#gpio-cells = <0x02>;
			status = "disabled";
		};

		ecc@25010000 {
			compatible = "ti,am64-elm";
			reg = <0x00 0x25010000 0x00 0x2000>;
			interrupts = <0x00 0x84 0x04>;
			power-domains = <0x03 0x36 0x01>;
			clocks = <0x02 0x36 0x00>;
			clock-names = "fck";
			status = "disabled";
		};
	};

	clock-divider-oldi {
		compatible = "fixed-factor-clock";
		clocks = <0x02 0xba 0x00>;
		#clock-cells = <0x00>;
		clock-div = <0x07>;
		clock-mult = <0x01>;
		phandle = <0x3d>;
	};

	thermal-zones {

		main0-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x1f4>;
			thermal-sensors = <0x46 0x00>;

			trips {

				main0-alert {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x47>;
				};

				main0-crit {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x47>;
					cooling-device = <0x48 0xffffffff 0xffffffff 0x49 0xffffffff 0xffffffff 0x4a 0xffffffff 0xffffffff 0x4b 0xffffffff 0xffffffff>;
				};
			};
		};

		main1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x1f4>;
			thermal-sensors = <0x46 0x01>;

			trips {

				main1-alert {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x4c>;
				};

				main1-crit {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x4c>;
					cooling-device = <0x48 0xffffffff 0xffffffff 0x49 0xffffffff 0xffffffff 0x4a 0xffffffff 0xffffffff 0x4b 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x48>;
