			sii9022@3b {
				#sound-dai-cells = <0x00>;
				compatible = "sil,sii9022";
				reg = <0x3b>;
				status = "okay";
				iovcc-supply = <0x1f>;
				cvcc12-supply = <0x20>;
				reset-gpios = <0x21 0x01 0x01>;
				sil,i2s-data-lanes = <0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x22>;
							phandle = <0x3f>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
