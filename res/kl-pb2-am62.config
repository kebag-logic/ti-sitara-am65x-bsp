# BeagleBoard.org PocketBeagle 2 (AM6254) delta on top of arm64 defconfig +
# res/kl-tdm8-uac2.config.
#
# Merge order matters (build-tdm8-uac2-pb2.sh config does this):
#   arm64 defconfig  <-  res/kl-tdm8-uac2.config  <-  res/kl-pb2-am62.config
# so anything here wins over the shared TDM8 fragment.
#
# arm64 defconfig already carries the whole K3 base as built-ins (ARCH_K3,
# MMC_SDHCI_AM654, TI_K3_UDMA, PINCTRL_SINGLE, I2C_OMAP, SERIAL_8250_OMAP,
# REGULATOR_GPIO/FIXED).  This fragment only pins the handful PocketBeagle 2
# actually depends on so a later olddefconfig or kernel bump cannot silently
# drop them.

# --- rootfs on the microSD ---
# sdhci1 is the ONLY MMC host k3-am62-pocketbeagle2.dts enables (there is no
# eMMC on this board), but it still enumerates as mmcblk1, not mmcblk0: the
# board's aliases node says "mmc1 = &sdhci1" and mmc_alloc_host() takes
# host->index from of_alias_get_id(np, "mmc").  Its vmmc-supply is
# a fixed regulator gated by GPIO0_0 and its vqmmc-supply is a GPIO regulator
# on GPIO1_49; both must be built in or the card never powers up.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_AM654=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_GPIO_DAVINCI=y
CONFIG_EXT4_FS=y

# --- console: two candidates, both 8250_omap ---
#   main_uart6 = ttyS2 (aliases serial2), the 3-pin JST-SH debug port
#   main_uart0 = ttyS3 (aliases serial3), P1.30 TXD / P1.32 RXD on the header
# The build script puts the kernel on ttyS3 so it shares a wire with the R5 SPL,
# TF-A, OP-TEE and U-Boot; see DEFAULT_APPEND in build-tdm8-uac2-pb2.sh.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- PMIC + the I2C buses it and the on-board MSPM0 live on ---
# tps65219 @ wkup_i2c0 0x30 supplies the core rails; without it built in the
# board still boots but every regulator is a stub.
CONFIG_I2C=y
CONFIG_I2C_OMAP=y
CONFIG_MFD_TPS65219=y
CONFIG_REGULATOR_TPS65219=y

# --- McASP needs the K3 BCDMA/PKTDMA backend built in ---
CONFIG_TI_K3_UDMA=y
CONFIG_TI_K3_PSIL=y
CONFIG_TI_K3_RINGACC=y

# --- usb0 (UAC2 + ECM) is the management link on a bare board ---
# The gadget side comes from res/kl-tdm8-uac2.config; this just pins the
# controller behind the USB-C port.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_AM62=y

# --- Kebag-Logic Ethernet Cap: DP83867IR on CPSW3G port 2 (RGMII2) ---
# The bare board has no Ethernet; k3-am62-pocketbeagle2-ethcap.dtb enables
# CPSW3G port 2 for the cap.  Built in, not modules: the PHY reset GPIO and the
# MDIO bus are sequenced at probe, and eth0 must exist when S40network runs.
CONFIG_TI_K3_AM65_CPSW_NUSS=y
CONFIG_TI_DAVINCI_MDIO=y
CONFIG_PHY_TI_GMII_SEL=y
CONFIG_DP83867_PHY=y
# The cap's point is the AM62x TSN hardware: the CPTS is eth0's PTP clock
# (ptp4l -i eth0 needs it for hardware timestamps), and CPSW_QOS offloads
# taprio (EST) and mqprio/cbs shaping.  TAPRIO must be =y for CPSW_QOS, a bool
# that depends on it.
CONFIG_PTP_1588_CLOCK=y
CONFIG_TI_K3_AM65_CPTS=y
CONFIG_TI_AM65_CPSW_QOS=y
CONFIG_PACKET=y
CONFIG_VLAN_8021Q=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_NET_SCH_CBS=y
CONFIG_NET_SCH_ETF=y
CONFIG_NET_SCH_TAPRIO=y

# --- no on-board audio codec on this board, so nothing to keep alive here ---

# --- A stable, self-identifying kernel release ---
# res/kl-tdm8-uac2.config pins "-tdm8" for the MYIR board and
# res/kl-sk-am62b.config pins "-tdm8-sk".  Override again so all three boards'
# modules can live side by side in one staging tree or rootfs: `uname -r` reads
# 7.1.0-tdm8-pb2 here.
CONFIG_LOCALVERSION="-tdm8-pb2"
# CONFIG_LOCALVERSION_AUTO is not set
