# KL AVB/Milan + PREEMPT_RT kernel config fragment for MYIR AM6254 (CPSW3g)
# Merge onto res/defconfig: scripts/kconfig/merge_config.sh -m res/defconfig res/kl-avb-rt.config

# --- Real-time: flip the stock CONFIG_PREEMPT to fully-preemptible RT ---
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y

# --- CPSW3g Ethernet + PHY (pin even if auto-selected; YT8531 is MISSING in defconfig) ---
CONFIG_TI_K3_AM65_CPSW_NUSS=y
CONFIG_TI_K3_AM65_CPSW_SWITCHDEV=y
CONFIG_TI_DAVINCI_MDIO=y
CONFIG_PHY_TI_GMII_SEL=y
CONFIG_MOTORCOMM_PHY=y

# --- TSN hardware offload: EST/TAS + MQPRIO + frame-preemption (MISSING in defconfig) ---
CONFIG_TI_AM65_CPSW_QOS=y
CONFIG_TI_K3_AM65_CPTS=y

# --- AVB datapath: raw L2 socket, VLAN, PTP clock, traffic-shaping qdiscs ---
CONFIG_PACKET=y
CONFIG_VLAN_8021Q=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_NET_SCH_CBS=y
CONFIG_NET_SCH_ETF=y
CONFIG_NET_SCH_TAPRIO=y

# --- Audio: USB Audio Class 2.0 endpoint (the demo path) ---
CONFIG_SND_USB_AUDIO=y

# --- Optional on-board SGTL5000-on-McASP (not used by the USB-audio demo) ---
CONFIG_SND_SOC_DAVINCI_MCASP=m
CONFIG_SND_SOC_SGTL5000=m
CONFIG_SND_SOC_SIMPLE_CARD=m
