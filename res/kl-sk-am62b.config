# TI SK-AM62B-P1 delta on top of arm64 defconfig + res/kl-tdm8-uac2.config.
#
# Merge order matters (build-tdm8-uac2-sk.sh config does this):
#   arm64 defconfig  <-  res/kl-tdm8-uac2.config  <-  res/kl-sk-am62b.config
# so anything here wins over the shared TDM8 fragment.
#
# arm64 defconfig already carries the whole K3 base as built-ins (ARCH_K3,
# MMC_SDHCI_AM654, TI_K3_UDMA, PINCTRL_SINGLE, I2C_OMAP, SERIAL_8250_OMAP,
# GPIO_PCA953X, REGULATOR_GPIO/FIXED, TI_K3_AM65_CPSW_NUSS, DP83867_PHY).
# This fragment only pins the handful the SK actually depends on so a later
# olddefconfig or kernel bump cannot silently drop them.

# --- rootfs on the microSD ---
# sdhci1's vmmc-supply is vdd_mmc1, gated by line 3 of the TCA6424 expander on
# main_i2c1, and its vqmmc-supply is a GPIO regulator on main_gpio0.  All three
# must be built in or the card the rootfs lives on never powers up.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_AM654=y
CONFIG_I2C=y
CONFIG_I2C_OMAP=y
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_EXT4_FS=y

# --- console: main_uart0 = ttyS2 ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- McASP needs the K3 BCDMA/PKTDMA backend built in ---
CONFIG_TI_K3_UDMA=y
CONFIG_TI_K3_PSIL=y
CONFIG_TI_K3_RINGACC=y

# --- both Ethernet ports (CPSW3g + DP83867), for ssh/deploy alongside usb0 ---
CONFIG_TI_K3_AM65_CPSW_NUSS=y
CONFIG_TI_DAVINCI_MDIO=y
CONFIG_PHY_TI_GMII_SEL=y
CONFIG_DP83867_PHY=y

# --- on-board audio: keep the stock AM62x-SKEVM card usable.  The McASP1 TDM8
#     device tree disables that card; the McASP0/J3 one leaves it alone. ---
CONFIG_SND_SOC_TLV320AIC3X=m
CONFIG_SND_SOC_TLV320AIC3X_I2C=m

# --- USB-C: the TDM8 device trees force dr_mode = "peripheral", so the PD
#     controller is not on the path to a working gadget.  Kept as modules so
#     the port can go back to role switching by dropping that override. ---
CONFIG_TYPEC=m
CONFIG_TYPEC_TPS6598X=m
CONFIG_USB_ROLE_SWITCH=y

# --- A stable, self-identifying kernel release ---
# res/kl-tdm8-uac2.config pins "-tdm8" for the MYIR board.  Override it so the
# two boards' modules can live side by side in one rootfs or module staging
# tree: `uname -r` reads 7.1.0-tdm8-sk here.
CONFIG_LOCALVERSION="-tdm8-sk"
# CONFIG_LOCALVERSION_AUTO is not set
