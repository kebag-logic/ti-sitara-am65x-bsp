# Fetched/external source trees (built by build.sh, not part of this repo)
/optee_os/
/trusted-firmware-a/
/ti-linux-firmware/
/u-boot-official/
# BeagleBoard's U-Boot fork, cloned by fetch.sh; only PocketBeagle 2 uses it,
# because mainline has no board support for it yet (README.tdm8-pb2.md 5.1)
/u-boot-pb/

# Kernel module staging + large generated/backup artifacts
/.kstage/
/.kstage2/
/.kstage-tdm8/
/.kstage-tdm8-sk/
/.kstage-tdm8-pb2/
/res/spare-sd/
/res/spare-sd-sk/
# PocketBeagle 2: the staged boot/ tree IS tracked (see the commit "PB2: prepare the work for the TDM8 to usb bridge"), but the
# 1.6 GB card image build-spare-sd.sh writes next to it is not. It is sparse, so
# `du` under-reports it as ~190M - do not be fooled into adding it.
/res/spare-sd-pb2/*.img
/res/sd-boot-backup/

# generated bootchooser script (built from res/ab/boot.cmd)
/res/ab/boot.scr

# signed RAUC bundle + signing key (build-rauc-bundle.sh); provide your own key, never commit it
/res/rauc/*.raucb
/res/rauc/*.key.pem

# TDM8 device tree generated from the vendor blob by res/tdm8/mk-tdm8-dtb.py
/res/tdm8/k3-am625x-myd-6254-tdm8.dtb
/res/tdm8/k3-am625x-myd-6254-tdm8.dts

# TDM8 device trees for the TI SK-AM62B-P1, compiled in-tree from the .dts next
# to them by build-tdm8-uac2-sk.sh dtb
/res/tdm8-sk/*.dtb
