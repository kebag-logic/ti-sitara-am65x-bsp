#!/bin/sh

# AVB network prep on boot: VLAN + traffic shaper + gPTP (PipeWire is started separately)
# Sources /etc/avb/avb.env and delegates to the deployed pipewire-helper scripts

[ -f /etc/avb/avb.env ] && . /etc/avb/avb.env

start() {
	# Bail out cleanly if the helper scripts are not deployed yet
	[ -d "$PW_HELPER_DIR" ] || { echo "S95avb: $PW_HELPER_DIR missing, skipping"; return 0; }
	ip link set dev "$AVB_INTERFACE" up
	"$PW_HELPER_DIR/setup-vlan.sh" "$AVB_INTERFACE"
	"$PW_HELPER_DIR/prepare-traffic-shaper-am62x.sh" "$AVB_INTERFACE"
	AVB_INTERFACE="$AVB_INTERFACE" "$PW_HELPER_DIR/ptp-start.sh" "$AVB_INTERFACE" &
}

stop() {
	pkill ptp4l 2>/dev/null
	pkill phc2sys 2>/dev/null
	tc qdisc del dev "$AVB_INTERFACE" root 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
