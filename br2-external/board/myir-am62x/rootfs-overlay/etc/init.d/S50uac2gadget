#!/bin/sh

# Start the USB 2.0 UAC2 audio gadget before AVB so its ALSA card exists for PipeWire to bridge
# Skeleton init wrapper around /usr/sbin/setup-uac2-gadget.sh (overrides come from /etc/avb/avb.env)

[ -f /etc/avb/avb.env ] && . /etc/avb/avb.env
UAC2=/usr/sbin/setup-uac2-gadget.sh

start() {
	[ -x "$UAC2" ] || { echo "S50uac2gadget: $UAC2 missing, skipping"; return 0; }
	SRATE="${UAC2_SRATE:-48000}" CHMASK="${UAC2_CHMASK:-3}" SSIZE="${UAC2_SSIZE:-2}" "$UAC2" up
}

case "$1" in
	start) start ;;
	stop) [ -x "$UAC2" ] && "$UAC2" down ;;
	restart) "$0" stop; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
