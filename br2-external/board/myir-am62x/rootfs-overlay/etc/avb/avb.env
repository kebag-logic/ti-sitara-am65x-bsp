# AVB runtime settings sourced by /etc/init.d/S95avb and /etc/init.d/S50uac2gadget (edit for your board)
# eth1 = AVB network, eth0 = management/deploy net - never shape eth0
AVB_INTERFACE=eth1
# VLAN id used by the AVB stream
AVB_VLAN_ID=2
# Where the pipewire-helper scripts are deployed on the target
PW_HELPER_DIR=/opt/pipewire-helper
# USB UAC2 gadget audio format (matches the 48k AVB AAF stream); chmask 3 = stereo, ssize 2 = 16-bit
UAC2_SRATE=48000
UAC2_CHMASK=3
UAC2_SSIZE=2
