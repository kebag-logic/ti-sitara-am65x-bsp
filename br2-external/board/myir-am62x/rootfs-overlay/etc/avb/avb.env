# AVB runtime settings sourced by /etc/init.d/S95avb (edit for your board)
# Which CPSW3g port carries AVB (confirm eth0/eth1 -> ENET1/ENET2 on the board)
AVB_INTERFACE=eth0
# VLAN id used by the AVB stream
AVB_VLAN_ID=2
# Where the pipewire-helper scripts are deployed on the target
PW_HELPER_DIR=/opt/pipewire-helper
