# TDM8 (McASP1 on J11) <-> USB Audio Class 2.0 gadget - runtime tunables.
# Read by /usr/sbin/tdm8-uac2.sh. See README.tdm8-uac2.md.

# Set to "yes" to make S99usb_gadgets build the TDM8 gadget + bridge at boot
# instead of the plain composite gadget from /root/setup_gadgets.sh.
TDM8_ENABLE=no

# --- the TDM link. These MUST match the FPGA's BCLK/FSYNC, which is the
#     clock master: nothing on the AM62x side can force the rate. ---
TDM8_RATE=48000
TDM8_CHANNELS=8
# S32_LE (4 bytes/sample, 24 valid bits left-justified in a 32-bit slot),
# S24_3LE (3 bytes) or S16_LE (2 bytes). Must match dai-tdm-slot-width in the DT.
TDM8_FORMAT=S32_LE

# --- ALSA card ids. "TDM8" comes from simple-audio-card,name in the device
#     tree; "UAC2Gadget" is f_uac2's own card name with the '_' stripped. ---
TDM8_CARD_ID=TDM8
TDM8_GADGET_CARD_ID=UAC2Gadget

# --- alsaloop bridge ---
# --sync: samplerate = async SRC, absorbs the FPGA-vs-host clock drift (needs
#         libsamplerate); none = straight copy, lowest CPU, drifts to an xrun
#         eventually; captshift/playshift = rate-shift instead of resampling.
TDM8_SYNC=samplerate
# Target end-to-end latency per direction, in microseconds.
TDM8_LATENCY_US=8000
# Seconds to wait at boot for both ALSA cards to appear.
TDM8_WAIT_CARDS=20

# --- USB gadget ---
# UDC to bind to; empty = the first one in /sys/class/udc.
TDM8_UDC=
# Pre-allocated USB requests per direction. 8ch needs more than the default 2.
TDM8_REQ_NUMBER=4
# Max extra bandwidth the async feedback endpoint may ask for.
TDM8_FB_MAX=5

# --- keep the ECM management link (usb0 = ssh/rauc over the same cable) ---
TDM8_ECM=yes
TDM8_USB0_IP=192.168.7.10/24
TDM8_ECM_DEV_ADDR=6a:65:62:6f:6f:00
TDM8_ECM_HOST_ADDR=6a:65:62:6c:6f:02
