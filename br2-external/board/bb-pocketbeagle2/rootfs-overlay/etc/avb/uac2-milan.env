# USB Audio Class 2.0 gadget profile of the USB-to-Milan bridge (issue #7).
# S99usb_gadgets builds the gadget from this file instead of /etc/tdm8/tdm8.env
# whenever the AVB interface exists (the "ethcap" label), with
# TDM8_ENV=<this file> /usr/sbin/tdm8-uac2.sh gadget-up, and starts no
# alsaloop bridge: the Milan media plane owns the gadget's PCMs.
#
# Same composite UAC2 + ECM function as the TDM8 bridge, tuned for latency:
# one isochronous packet per 125 us microframe in each direction.

# Milan AAF base format: 48 kHz, 32-bit samples, 8 channels per stream
TDM8_RATE=48000
TDM8_CHANNELS=8
TDM8_FORMAT=S32_LE
TDM8_DIRECTION=duplex

# bInterval 1 on both isochronous endpoints: 125 us packets of 6 frames. f_uac2
# would pick bInterval 3 (500 us) for 8 x 32-bit on its own.
TDM8_HS_BINT=1
# USB requests queued per direction. Board -> host (IN) data waits behind them,
# so 4 x 125 us = 500 us of the IN path; host -> board (OUT) completes per packet.
TDM8_REQ_NUMBER=4
# Async feedback range in 0.1 % steps; the media clock servo stays well inside it
TDM8_FB_MAX=5

TDM8_PRODUCT="PocketBeagle 2 USB-Milan bridge"
TDM8_FUNCTION_NAME="KL Milan bridge 8x8"
TDM8_CONFIG_NAME="Milan bridge 8ch @ 48000 Hz"

# ECM keeps the second way in, as on the TDM8 labels, but on a subnet and MAC
# pair of its own: a TDM8 PocketBeagle 2 on the same host keeps 192.168.7.12
# and ...:20/...:22, so the two boards' links never collide. Host side:
# 192.168.8.1/24 on the interface with MAC 6a:65:62:6c:6f:32.
TDM8_ECM=yes
TDM8_USB0_IP=192.168.8.12/24
TDM8_ECM_DEV_ADDR=6a:65:62:6f:6f:30
TDM8_ECM_HOST_ADDR=6a:65:62:6c:6f:32
TDM8_GADGET_CARD_ID=UAC2Gadget
