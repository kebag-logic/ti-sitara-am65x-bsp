# AVB / Milan runtime settings for the PocketBeagle 2 with the Kebag-Logic
# Ethernet Cap. Sourced by /etc/init.d/S95avb, the /usr/sbin/avb-*.sh helpers
# and /etc/init.d/S99usb_gadgets. See README.pb2-tsn.md.

# The cap's port. It is also the management path: the helpers never tag or
# shape untagged best-effort traffic, which stays in traffic class 0.
AVB_INTERFACE=eth0
AVB_VLAN_ID=2

# What S95avb starts on top of gPTP, the VLAN and the shaper:
#   native   = the USB-to-Milan bridge daemons (path A), when installed
#   pipewire = PipeWire module-avb (path B, not wired yet)
#   none     = the TSN plumbing only
AVB_STACK=native

# gPTP (802.1AS) on the CPTS hardware clock. ptp4l stays above phc2sys, and
# both stay above every audio thread.
AVB_GPTP_CFG=/etc/avb/gPTP.cfg
AVB_PTP4L_PRIO=53
AVB_PHC2SYS_PRIO=52

# am65-cpsw floods a VLAN's unregistered multicast to the host port only with
# allmulticast on, and AVTP streams use multicast destinations.
AVB_ALLMULTI=yes

# Egress shaper: am65-cpsw mqprio in channel mode with bw_rlimit (no CBS
# offload). The class A rate is computed from the streams below, rounded up to
# the shaper's 1 Mbit/s step, unless AVB_CLASS_A_MBIT is set. Class B gets a
# traffic class only when AVB_CLASS_B_MBIT is non-zero.
AVB_CLASS_A_STREAMS=1
AVB_CLASS_A_CHANNELS=8
AVB_CLASS_A_SAMPLE_BYTES=4
AVB_CLASS_A_SAMPLES_PER_FRAME=6
AVB_CLASS_A_FRAMES_PER_SEC=8000
AVB_CLASS_A_MBIT=
AVB_CLASS_B_MBIT=0
# Socket priorities (SO_PRIORITY) of the two classes; each is also its PCP.
AVB_CLASS_A_PRIO=3
AVB_CLASS_B_PRIO=2

# The bridge's control plane (milan-ctrld, through /usr/sbin/milan-bridge.sh):
# its SCHED_FIFO priority, below gPTP, and its entity description.
AVB_CTRLD_PRIO=40
AVB_ENTITY_CONF=/etc/milan/entity.conf
# Its media plane (milan-mediad): the talker thread's SCHED_FIFO priority, on
# AVB_RT_CPU; the presentation time offset; the frames the media clock servo
# keeps in the gadget's buffer, the bridge's own latency (24 = 500 us).
AVB_MEDIAD_PRIO=70
AVB_PTO_NS=2000000
AVB_TALKER_LEVEL=24
# The listener's view of the gadget's USB IN pipeline: the requests already
# filled ahead of a frame it queues (TDM8_REQ_NUMBER x 125 us in uac2-milan.env).
AVB_USB_IN_FLIGHT_NS=500000
# The SRP domain: "none" while the bridge has no SRP (#14), on a direct link
# with no MSRP bridge; a settled listener then takes its talker as registered.
AVB_SRP_DOMAIN=none

# CPU placement. The "ethcap" boot label isolates CPU 3 for the media plane;
# the CPSW and USB interrupts are pinned to AVB_IRQ_CPU.
AVB_RT_CPU=3
AVB_IRQ_CPU=2
# /proc/interrupts names of those interrupts (an extended regular expression)
AVB_IRQ_MATCH='8000000\.ethernet|31000000\.usb'

# USB gadget profile of the bridge, built by S99usb_gadgets instead of the TDM8
# one whenever AVB_INTERFACE exists (the "ethcap" label).
AVB_GADGET_ENV=/etc/avb/uac2-milan.env
