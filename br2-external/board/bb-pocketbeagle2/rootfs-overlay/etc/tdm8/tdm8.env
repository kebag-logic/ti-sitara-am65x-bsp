# TDM8 <-> USB Audio Class 2.0 gadget - runtime tunables for the PocketBeagle 2.
# Read by /usr/sbin/tdm8-uac2.sh. See README.tdm8-pb2.md.

# Set to "yes" to make S99usb_gadgets build the TDM8 gadget + bridge at boot
# instead of the plain composite gadget from /root/setup_gadgets.sh.
TDM8_ENABLE=yes

# --- which half of the link is wired, i.e. which device tree is booted ---
#   duplex = k3-am62-pocketbeagle2-tdm8.dtb        McASP0, 8 in + 8 out, 4 wires
#            k3-am62-pocketbeagle2-tdm8-async.dtb  same, separate RX clock pair
# Both PocketBeagle 2 trees are full duplex - this board brings a whole McASP0
# out to P1/P2, so unlike the SK there is no capture-only fallback to fall to.
TDM8_DIRECTION=duplex

# --- the TDM link. These MUST match the FPGA's BCLK/FSYNC, which is the
#     clock master: nothing on the AM62x side can force the rate. ---
TDM8_RATE=48000
TDM8_CHANNELS=8
# S32_LE (4 bytes/sample, 24 valid bits left-justified in a 32-bit slot),
# S24_3LE (3 bytes) or S16_LE (2 bytes). Must match dai-tdm-slot-width in the DT.
TDM8_FORMAT=S32_LE

# --- ALSA card ids. "TDM8" comes from simple-audio-card,name in the device
#     tree; "UAC2Gadget" is f_uac2's own card name with the '_' stripped.
#     PocketBeagle 2 has no on-board codec, so TDM8 is the only McASP card -
#     but these are still looked up by id, not by index, so the gadget card
#     appearing first cannot shift them. ---
TDM8_CARD_ID=TDM8
TDM8_GADGET_CARD_ID=UAC2Gadget

# --- alsaloop bridge ---
# --sync: samplerate = async SRC, absorbs the FPGA-vs-host clock drift (needs
#         libsamplerate); none = straight copy, lowest CPU, drifts to an xrun
#         eventually; captshift/playshift = rate-shift instead of resampling.
TDM8_SYNC=samplerate
# Target end-to-end latency per direction, in microseconds. Duplex on 512 MB of
# DDR with four A53s at 1.4 GHz has headroom; drop toward 4000 once the link is
# proven and watch for xruns in `dmesg`.
TDM8_LATENCY_US=8000
# Seconds to wait at boot for both ALSA cards to appear.
TDM8_WAIT_CARDS=20

# --- USB gadget on the USB-C port (usb0 = 31000000.usb) ---
# k3-am62-pocketbeagle2.dts already sets dr_mode = "peripheral" on &usb0 (it is
# a Type-C socket wired as USB 2.0), so the TDM8 trees do not have to override
# it the way the SK trees do.
# UDC to bind to; empty = the first one in /sys/class/udc.
TDM8_UDC=
# Pre-allocated USB requests per direction. 8ch needs more than the default 2.
TDM8_REQ_NUMBER=4
# Max extra bandwidth the async feedback endpoint may ask for.
TDM8_FB_MAX=5

# --- keep the ECM management link (usb0 = ssh over the same cable) ---
# On this board that is not a convenience: PocketBeagle 2 has no Ethernet at
# all, so the ECM leg of the composite gadget is the ONLY network path to the
# board. Turning it off leaves the serial console as the only way in.
TDM8_ECM=yes
TDM8_USB0_IP=192.168.7.12/24
TDM8_ECM_DEV_ADDR=6a:65:62:6f:6f:20
TDM8_ECM_HOST_ADDR=6a:65:62:6c:6f:22
