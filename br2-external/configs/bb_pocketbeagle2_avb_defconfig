BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_OPTIMIZE_2=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BASH=y
# Follow whatever the kernel's last console= is rather than hardcoding a port.
# PocketBeagle 2 has two candidates - main_uart6 (JST-SH) is ttyS2 and
# main_uart0 (P1.30/P1.32) is ttyS3 - and the build script puts the kernel on
# ttyS3 so the whole boot log lands on one wire. "console" keeps the login
# prompt on the same port without this file having to know which it is.
# ttyS3 = main_uart0 = P1.30/P1.32, fixed by "serial3 = &main_uart0" in the
# board aliases, so this is deterministic rather than a guess. Deliberately a
# real tty and not "console": /dev/console fans out to every console= on the
# cmdline and its input side depends on which one ends up CON_CONSDEV, which is
# more indirection than a login prompt needs.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS3"
# Explicit rather than BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP, which emits
# "getty -L console 0 vt100" - the 0 means "inherit the console's current
# termios", so the login prompt silently follows whatever speed the port was
# left at. Everything else in this chain is 115200: U-Boot's CONFIG_BAUDRATE,
# the kernel's console= and earlycon. Pin the getty to match.
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# two overlays: the board-independent TDM8/gadget scripts, then this board's own
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KL_AM62X_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_KL_AM62X_PATH)/board/bb-pocketbeagle2/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_KL_AM62X_PATH)/board/bb-pocketbeagle2/post-build.sh"
BR2_PACKAGE_PIPEWIRE_UPSTREAM=y
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# alsaloop bridges the McASP TDM8 card to the UAC2 gadget card
BR2_PACKAGE_ALSA_UTILS_ALSALOOP=y
# amixer reaches the gadget's "Capture Pitch 1000000" feedback control
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
# libsamplerate gives alsaloop --sync=samplerate (FPGA-vs-host clock drift)
BR2_PACKAGE_LIBSAMPLERATE=y
# gpiod is how you read back the parked partner balls on P1.02/P1.04/P2.01/P2.03
# (see the device-tree header) and poke the four user LEDs on GPIO0_3..6
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_LIBCAP=y
BR2_PACKAGE_LIBCAP_TOOLS=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_E2FSPROGS=y
# First boot grows / to the whole card (/etc/init.d/S05growrootfs): sfdisk
# moves the end of the root partition, partx tells the running kernel, and
# resize2fs grows the mounted ext4. None of the three is in BusyBox.
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_RT_TESTS=y
# The bare board has no Ethernet, but with the Kebag-Logic Ethernet Cap and
# k3-am62-pocketbeagle2-ethcap.dtb it has eth0 (DP83867 on CPSW3G port 2).
# ethtool shows the PHY link, the CPTS PTP clock (ethtool -T eth0) and the
# MAC/PHY counters; iperf3 is the 1000 Mb/s check the cap's rev B handover asks
# for on the shared RGMII pins.
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPERF3=y
# The TSN validation (README.pb2-tsn.md): stress-ng is the load under which
# cyclictest must hold its bound, and tcpdump captures AVTP on the board itself.
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_TCPDUMP=y
# taskset and chrt, to place the validation's load and measurements
BR2_PACKAGE_UTIL_LINUX_SCHEDUTILS=y
# The USB-to-Milan bridge (README.pb2-tsn.md, path A): milan-ctrld, the Milan
# control plane, built from milan-linux/ and milan-fpga at milan-fpga.pin
BR2_PACKAGE_MILAN_BRIDGE=y
# 512 MB of DDR, so the rootfs is sized well under the SK's 2G.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_TARGET_ROOTFS_TAR_GZIP=y
