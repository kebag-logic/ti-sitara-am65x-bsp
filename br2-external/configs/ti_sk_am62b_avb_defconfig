BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_OPTIMIZE_2=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BASH=y
# SK-AM62B-P1 console is main_uart0 on the XDS110 USB debug port = ttyS2
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
# two overlays: the board-independent TDM8/gadget scripts, then this board's own
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KL_AM62X_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_KL_AM62X_PATH)/board/ti-sk-am62b/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_KL_AM62X_PATH)/board/ti-sk-am62b/post-build.sh"
BR2_PACKAGE_PIPEWIRE_UPSTREAM=y
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# alsaloop bridges the McASP TDM8 card to the UAC2 gadget card
BR2_PACKAGE_ALSA_UTILS_ALSALOOP=y
# amixer reaches the gadget's "Capture Pitch 1000000" feedback control
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
# libsamplerate gives alsaloop --sync=samplerate (FPGA-vs-host clock drift)
BR2_PACKAGE_LIBSAMPLERATE=y
# gpiod drives the TCA6424 MCASP1_FET_* lines that steer the McASP1 bus
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_LIBCAP=y
BR2_PACKAGE_LIBCAP_TOOLS=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_STRESS_NG=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_TAR_GZIP=y
