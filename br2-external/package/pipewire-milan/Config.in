config BR2_PACKAGE_PIPEWIRE_MILAN
	bool "pipewire-milan (AVB/Milan fork)"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on !BR2_PACKAGE_PIPEWIRE
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LINUXPTP
	help
	  PipeWire built from the Milan AVB fork (gitlab Mister-M-alt/pipewire)
	  with the module-avb / Milan support enabled. Installs /usr/bin/pipewire
	  so it conflicts with the stock pipewire package (disable that one).

	  Alternative: keep stock pipewire and deploy the Milan build at runtime
	  with the pipewire-helper build-and-install script instead of this package.

comment "pipewire-milan needs threads and conflicts with the stock pipewire package"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_PACKAGE_PIPEWIRE
